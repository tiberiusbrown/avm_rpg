// A lever is thrown back off: the same scrape, then a lower clunk that falls as the lever seats.
sfx
volume max
automation 8ms
instrument scrape { wave noise volume 5 volume_slide { to 9 over 40ms } }
instrument clack { wave noise volume 12 volume_slide { to 0 over 30ms } }
instrument clunk {
    wave pulse duty 50% volume 12
    frequency_slide { delta -300cents over 40ms }
    volume_slide { to 0 over 70ms }
}
channel 3 octave 4 { c:40ms@scrape c:30ms@clack }
channel 1 clunk octave 3 { r:40ms d:70ms }
