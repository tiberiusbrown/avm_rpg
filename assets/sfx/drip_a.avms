// A drop falls into a pool somewhere in the dark: a bright plink and its fainter echo.
sfx
volume 140%
automation 8ms
instrument plink {
    wave pulse duty 25% volume 7
    frequency_slide { delta -700cents over 50ms }
    volume_slide { to 0 over 70ms }
}
instrument echo {
    wave pulse duty 25% volume 3
    frequency_slide { delta -700cents over 50ms }
    volume_slide { to 0 over 70ms }
}
channel 1 octave 6 { e:70ms@plink r:110ms e:70ms@echo }
