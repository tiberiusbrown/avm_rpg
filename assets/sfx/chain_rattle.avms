// A chain stirs in the dark: a run of dull noise ticks and two thin clinks of metal.
sfx
volume 140%
automation 8ms
instrument link { wave noise volume 5 note_cut { after 4ms } }
instrument clink {
    wave pulse duty 12.5% volume 4
    volume_slide { to 0 over 40ms }
}
channel 3 link octave 4 {
    repeat 4 { c:8ms r:20ms }
    r:36ms
    repeat 3 { c:8ms r:24ms }
}
channel 1 clink octave 6 { r:24ms b:40ms r:120ms g#:40ms }
