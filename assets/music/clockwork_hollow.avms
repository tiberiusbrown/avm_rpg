title "Clockwork Hollow"
description "A quiet, wistful mystery: a rising fourth and two long falling notes, with a warmer middle section."

// Original composition for AVM RPG; no reference MIDI notes are imported.
// A minor, 16 bars in 4/4, A / A' / B / A''. The two-bar refrain
// returns at bars 5 and 13. The lead occupies the upper register; quiet backing
// figures answer its cadential breaths.
tempo 100
meter 4/4
loop
automation 8ms

envelope singing {
    points 0ms:0%, 16ms:100%, 120ms:95%, 800ms:85%
    sustain
    release 40ms:0%
}
envelope plucked {
    points 0ms:0%, 8ms:100%, 64ms:65%, 200ms:40%
    sustain
    release 32ms:0%
}
envelope foundation {
    points 0ms:0%, 16ms:100%, 120ms:85%
    sustain
    release 40ms:0%
}
envelope brushed {
    points 0ms:0%, 4ms:100%, 12ms:30%, 24ms:0%
}
instrument lead { wave pulse duty 50% volume 18 envelope singing gate 93% }
instrument accompaniment { wave pulse duty 25% volume 3 envelope plucked gate 82% }
instrument bass { wave pulse duty 50% volume 5 envelope foundation gate 85% }
instrument brush { wave noise volume 1 envelope brushed gate 50% }

phrase hollow_refrain { e4 a2 c'4 | b2 a2 | }

channel 0 lead octave 5 {
    // A: a rising fourth and an unhurried falling answer.
    hollow_refrain
    g4 a4 b2 | e2. r4 |
    // A': recognize the same opening, then land on the minor tonic.
    hollow_refrain
    d'2 c'4 b4 | a2. r4 |
    // B: the relative major briefly opens a window, then closes gently.
    c'4 e'2 d'4 | c'2 b4 a4 |
    g2 a4 b4 | ab2. r4 |
    // A'': a half-step longing resolves into the original home note.
    hollow_refrain
    g4 f4 e2 | a2. r4 |
}

channel 1 accompaniment octave 4 {
    r4 c4 e4 c4 | r4 b,4 d4 b,4 | r4 b,4 d4 b,4 | ab2 b,4 a8 ab8 |
    r4 c4 e4 c4 | r4 b,4 d4 b,4 | r4 f4 a,4 f4 | c2 e4 d8 c8 |
    r4 a,4 c4 a,4 | r4 f4 a,4 f4 | r4 b,4 d4 b,4 | ab2 b,4 a8 ab8 |
    r4 c4 e4 c4 | r4 b,4 d4 b,4 | r4 ab4 b,4 ab4 | c2 e2 |
}

channel 2 bass octave 3 {
    a4 r4 e'4 r4 | g4 r4 d'4 r4 | g4 r4 d'4 r4 | e4 r4 b4 r4 |
    a4 r4 e'4 r4 | g4 r4 d'4 r4 | d4 r4 a4 r4 | a4 r4 e'4 r4 |
    f4 r4 c'4 r4 | d4 r4 a4 r4 | g4 r4 d'4 r4 | e4 r4 b4 r4 |
    a4 r4 e'4 r4 | g4 r4 d'4 r4 | e4 r4 b4 r4 | a2 e'2 |
}

phrase light_beat { r2 b8 r8 r4 }
channel 3 brush octave 6 { repeat 16 { light_beat | } }
