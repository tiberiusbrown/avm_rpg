// Steel at Dawn — original eight-bar fantasy battle loop.
// Key: D minor | 152 BPM | about 12.6 seconds per loop.
// Enable repetition during playback with avm_audio_music_loop(1).

title "Steel at Dawn"
description "Urgent but melodic fantasy RPG encounter theme"
tempo 152
meter 4/4
volume max
automation 8ms

envelope lead_env {
    points 0ms:100%, 80ms:90%, 160ms:76%
    release 24ms:0%
}
envelope chord_env {
    points 0ms:100%, 72ms:85%, 160ms:65%
    release 16ms:0%
}
envelope bass_env {
    points 0ms:100%, 72ms:82%, 160ms:65%
    release 20ms:0%
}
envelope kick_env { points 0ms:100%, 36ms:55%, 105ms:0% }
envelope snare_env { points 0ms:100%, 20ms:75%, 90ms:0% }
envelope hat_env { points 0ms:100%, 28ms:0% }

instrument lead  { wave pulse duty 25% volume 15 envelope lead_env gate 90% }
instrument chord { wave pulse duty 50% volume 7 envelope chord_env gate 84% }
instrument bass  { wave saw volume 10 envelope bass_env gate 85% }
instrument kick  { wave noise volume 7 envelope kick_env gate 85% }
instrument snare { wave noise volume 6 envelope snare_env gate 85% }
instrument hat   { wave noise volume 2 envelope hat_env gate 55% }

// Foreground melody: an ascending rallying figure, answered by a
// rising dominant. The final C# leads directly back to the opening D.
channel 0 lead octave 5 {
    d8   f8  a8   d'8  c'4  a8   f8   | // Dm
    bb8  d'8 c'8  bb8  a4   f8   a8   | // Bb
    g8   c'8 e'8  d'8  c'4  g8   e8   | // C
    a8   c#'8 e'8 d'8  c#'4 r8   a8   | // A7

    d8   f8  a8   d'8  c'8  a8   f4   | // Dm
    c'8  a8  f8   a8   c'4  d'8  c'8  | // F
    bb8  a8  g8   f8   g4   bb8  a8   | // Gm
    c#'8 e'8 d'8  c#'8 a8   g8   e8   c#8 | // A7 -> Dm
}

// Short offbeat arpeggios leave the downbeats to the bass and lead.
// A7 uses its seventh (G) to add tension before each return to Dm.
channel 1 chord octave 3 {
    arpeggio { offsets 0,3,7 step 40ms }
    r8 d8   r8 d8   r8 d8   r8 d8   | // Dm

    arpeggio { offsets 0,4,7 step 40ms }
    r8 bb,8 r8 bb,8 r8 bb,8 r8 bb,8 | // Bb
    r8 c8   r8 c8   r8 c8   r8 c8   | // C

    arpeggio { offsets 0,4,7,10 step 40ms }
    r8 a,8  r8 a,8  r8 a,8  r8 a,8  | // A7

    arpeggio { offsets 0,3,7 step 40ms }
    r8 d8   r8 d8   r8 d8   r8 d8   | // Dm

    arpeggio { offsets 0,4,7 step 40ms }
    r8 f8   r8 f8   r8 f8   r8 f8   | // F

    arpeggio { offsets 0,3,7 step 40ms }
    r8 g8   r8 g8   r8 g8   r8 g8   | // Gm

    arpeggio { offsets 0,4,7,10 step 40ms }
    r8 a,8  r8 a,8  r8 a,8  r8 a,8  | // A7
}

// Driving root/fifth ostinato. Sawtooth harmonics help the lower
// notes stay audible on the piezo.
channel 2 bass octave 2 {
    d'8 d'8 a8  d'8 f'8 d'8 a8  d'8 | // Dm
    bb8 bb8 f'8 bb8 d'8 bb8 f'8 bb8 | // Bb
    c'8 c'8 g'8 c'8 e'8 c'8 g'8 c'8 | // C
    a8  a8  e'8 a8  g'8 a8  e'8 g'8 | // A7

    d'8 d'8 a8  d'8 f'8 d'8 a8  d'8 | // Dm
    f'8 f'8 c'8 f'8 a'8 f'8 c'8 f'8 | // F
    g'8 g'8 d'8 g'8 bb'8 g'8 d'8 g'8 | // Gm
    a8  a8  e'8 a8  g'8 e'8 c#'8 a8 | // A7
}

// One noise voice: alternating thumps, clicks, and snare accents.
// A short snare fill in bar 8 signals the loop turnaround.
channel 3 octave 4 {
    repeat 7 {
        c8@kick b8@hat g8@snare b8@hat
        c8@kick b8@hat g8@snare b8@hat |
    }
    c8@kick b8@hat g8@snare b8@hat
    c8@kick g8@snare g8@snare g8@snare |
}
