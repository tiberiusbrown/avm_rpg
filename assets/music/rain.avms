channel 0 rain_pluck octave 3 {
    melody_opening              // Opening: frames 0–3
    melody_verse                // First variation: frames 4–7
    melody_refrain              // First refrain: frames 8–15
    melody_opening              // Return of opening: frames 16–19
    melody_bridge_a melody_bridge_b // Contrast: frames 20–27
    melody_refrain              // Closing refrain: frames 28–35
}
channel 1 rain_soft_lead octave 3 {
    harmony_opening              // Opening: frames 0–3
    harmony_verse                // First variation: frames 4–7
    harmony_refrain              // First refrain: frames 8–15
    harmony_opening              // Return of opening: frames 16–19
    harmony_bridge_a harmony_bridge_b // Contrast: frames 20–27
    harmony_refrain              // Closing refrain: frames 28–35
}
channel 2 rain_bass octave 3 {
    bass_opening              // Opening: frames 0–3
    bass_verse                // First variation: frames 4–7
    bass_refrain              // First refrain: frames 8–15
    bass_opening              // Return of opening: frames 16–19
    bass_bridge_a bass_bridge_b // Contrast: frames 20–27
    bass_refrain              // Closing refrain: frames 28–35
}
channel 3 rain_kick octave 3 {
    drums_opening              // Opening: frames 0–3
    drums_verse                // First variation: frames 4–7
    drums_refrain              // First refrain: frames 8–15
    drums_opening              // Return of opening: frames 16–19
    drums_bridge_a drums_bridge_b // Contrast: frames 20–27
    drums_refrain              // Closing refrain: frames 28–35
}
