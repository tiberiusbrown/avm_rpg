title "After the Rain"
description "After the Rain by Shiru (2011); rhythmic 5:3 swing and sample-accented percussion"
tempo 225
meter 4/4
automation 16ms
// Tracker F05/F03 swing alternates 5 and 3 NTSC ticks every two rows.
// Tempo 225 plus 5/4 and 3/4 duration multipliers reproduces those timings.
// Source also contains 5 DPCM samples. Onsets are represented as accentuated noise,
// merged into channel 3 where simultaneous; these are NOT reproduced sample waveforms.

// ------------------- Instrument palette -------------------

// Instrument families approximate the original 19 NES instruments.
// Fine 60Hz tracker volume/duty macros are represented with shared envelopes.
envelope rain_pluck { points 0ms:100%, 40ms:75%, 92ms:45%, 160ms:25% release 52ms:0% curve step }
envelope rain_soft { points 0ms:90%, 64ms:73%, 160ms:53% release 50ms:0% curve step }
envelope rain_bell { points 0ms:100%, 72ms:90%, 144ms:68%, 240ms:45% release 75ms:0% curve step }
envelope rain_perc { points 0ms:100%, 25ms:70%, 60ms:30%, 96ms:0% curve step }
instrument rain_pluck { wave pulse duty 25% volume 12 envelope rain_pluck gate 83% }
instrument rain_soft_lead { wave pulse duty 25% volume 9 envelope rain_soft gate 90% }
instrument rain_bright { wave pulse duty 12.5% volume 12 envelope rain_bell gate 91% }
instrument rain_pad { wave pulse duty 50% volume 10 envelope rain_soft gate 98% }
instrument rain_bass { wave triangle volume 11 gate 90% }
instrument rain_pizz { wave triangle volume 8 gate 80% }
instrument rain_kick { wave noise volume 10 envelope rain_perc gate 77% }
instrument rain_snare { wave noise volume 7 envelope rain_perc gate 75% }
instrument rain_hat { wave noise volume 4 envelope rain_perc gate 72% }
instrument rain_sample_accent { wave noise volume 12 envelope rain_perc gate 81% noise_retrigger { every 20ms seed 23 } }


// ------------------- Reusable four-bar patterns -------------------
// Pattern 00, 32 attacks
phrase melody_00 {
    octave 3
    use rain_pluck
    g8*5/4 g16. g8*5/4 g16.@rain_bright g8*5/4 g16.@rain_bright g8*5/4@rain_bright g16. |
    g8*5/4 g16. g8*5/4 g16.@rain_bright g8*5/4 g16.@rain_bright g8*5/4 g16. |
    a#8*5/4 a#16. a#8*5/4 a#16.@rain_bright a#8*5/4 a#16.@rain_bright a#8*5/4@rain_bright a#16. |
    a#8*5/4 a#16. a#8*5/4 a#16.@rain_bright a#8*5/4 a#16.@rain_bright a#8*5/4 a#16. |
}
