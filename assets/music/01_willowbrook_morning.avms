// WILLOWBROOK MORNING
// Original village theme. G major; gentle 4-bar periods, with a brighter middle answer.
// 16 measures, four channels, seamless loop.
title "Willowbrook Morning"
description "Sun through the village orchard; a friendly morning walk."
tempo 108
meter 4/4
loop

// Step contours limit automation while retaining the short, rounded ATMlib-style attack.
envelope lead_pluck { points 0ms:100%, 120ms:85%, 320ms:70% release 72ms:0% curve step }
envelope harp_decay { points 0ms:100%, 180ms:65% release 48ms:0% curve step }
envelope bass_decay { points 0ms:100%, 260ms:75% release 56ms:0% curve step }
envelope brush_decay { points 0ms:100%, 32ms:40%, 64ms:0% curve step }

instrument village_lead {
    wave triangle volume 24 envelope lead_pluck gate 88%
}
instrument village_harp_major {
    wave pulse duty 12.5% volume 5 envelope harp_decay gate 92%
    arpeggio { offsets 0,4,7,12 step 170ms repeat }
}
instrument village_harp_minor {
    wave pulse duty 12.5% volume 5 envelope harp_decay gate 92%
    arpeggio { offsets 0,3,7,12 step 170ms repeat }
}
instrument village_bass { wave triangle volume 15 envelope bass_decay gate 85% }
instrument village_brush { wave noise volume 8 envelope brush_decay gate 45% }

// One-bar cells make the independent parts easy to rearrange.
phrase bass_g   { g2 d'4 b4 | }
phrase bass_fsd { f#2 a4 d'4 | }
phrase bass_em  { e2 b4 g4 | }
phrase bass_c   { c2 g4 e'4 | }
phrase bass_am  { a2 e'4 c'4 | }
phrase bass_d   { d2 a4 f#4 | }
phrase bass_b   { b,2 f#4 d'4 | }
phrase brush_bar { c,8 r8 r4 c,8 r8 r4 | }
phrase brush_sparse { r4 c,8 r8 r2 | }

// CH0: melody -- a repeated rising call, then more expansive answers.
channel 0 village_lead octave 4 {
    // A: G - D/F# - Em - C
    b8 d'8 g'4 f#'8 e'8 d'4 |
    a8 d'8 f#'4 e'8 d'8 a4 |
    g8 b8 e'4 d'8 b8 g4 |
    e8 g8 c'4 b8 a8 g4 |
    // A': G - Am - D - G
    b8 d'8 g'4 a'8 g'8 d'4 |
    c'8 e'8 a'4 g'8 e'8 c'4 |
    a8 d'8 f#'4 e'8 d'8 c'4 |
    b8 a8 g4 b8 d'8 g'4 |
    // B: move the melody through the IV chord and a gentle descent.
    e'4 d'8 c'8 b4 g4 |
    d'4 b8 g8 a4 b4 |
    c'8 d'8 e'4 d'8 c'8 a4 |
    f#'8 e'8 d'4 a8 c'8 d'4 |
    // Return home.
    b8 e'8 g'4 f#'8 e'8 d'4 |
    c'8 b8 g4 e8 g8 c'4 |
    a8 c'8 d'4 f#'8 e'8 d'4 |
    b8 a8 g2. |
}

// CH1: one held root per bar; the named arpeggio instrument supplies the motion.
channel 1 village_harp_major octave 3 {
    g1 | d1 | e1@village_harp_minor | c1 |
    g1 | a1@village_harp_minor | d1 | g1 |
    c1 | g1 | a1@village_harp_minor | d1 |
    e1@village_harp_minor | c1 | d1 | g1 |
}

// CH2: lower movement, independent of melody and of the arpeggio timing.
channel 2 village_bass octave 3 {
    bass_g bass_fsd bass_em bass_c
    bass_g bass_am bass_d bass_g
    bass_c bass_b bass_am bass_d
    bass_em bass_c bass_d bass_g
}

// CH3: quiet brushed pulses; less frequent in the second half.
channel 3 village_brush octave 4 {
    repeat 4 { brush_bar }
    repeat 4 { brush_bar }
    repeat 4 { brush_sparse }
    repeat 4 { brush_bar }
}
