title "Lantern Square"
description "A tender town song: a dotted rising call, a descending answer, and a single high point before the familiar return."

// Original composition for AVM RPG; no reference MIDI notes are imported.
// C major, 16 bars in 4/4, A / A' / B / A''. The two-bar refrain
// returns at bars 5 and 13. The lead occupies the upper register; quiet backing
// figures answer its cadential breaths.
tempo 108
meter 4/4
loop
automation 8ms

envelope singing {
    points 0ms:0%, 16ms:100%, 120ms:95%, 800ms:85%
    sustain
    release 40ms:0%
}
envelope plucked {
    points 0ms:0%, 8ms:100%, 64ms:65%, 200ms:40%
    sustain
    release 32ms:0%
}
envelope foundation {
    points 0ms:0%, 16ms:100%, 120ms:85%
    sustain
    release 40ms:0%
}
envelope brushed {
    points 0ms:0%, 4ms:100%, 12ms:30%, 24ms:0%
}
instrument lead { wave pulse duty 50% volume 18 envelope singing gate 93% }
instrument accompaniment { wave pulse duty 25% volume 4 envelope plucked gate 82% }
instrument bass { wave pulse duty 50% volume 5 envelope foundation gate 85% }
instrument brush { wave noise volume 1 envelope brushed gate 50% }

phrase square_refrain { g4. a8 c'2 | a2 g4 e4 | }

channel 0 lead octave 5 {
    // A: ask a small, singable question and allow the answer to linger.
    square_refrain
    f2 g4 a4 | g2. r4 |
    // A': the listener hears the same question, now answered at home.
    square_refrain
    f4 g4 d'2 | c'2. r4 |
    // B: the one high E is the emotional crest, followed by a long descent.
    e'2 d'4 c'4 | a2. g8 f8 |
    g4 a4 c'2 | b2. r4 |
    // A'': a final quiet cadence, followed by a breath into the loop.
    square_refrain
    f2 d4 b4 | c'2. r4 |
}

channel 1 accompaniment octave 4 {
    r8 e8 g4 r8 e8 c4 | r8 c8 e4 r8 c8 a,4 | r8 a,8 c4 r8 a,8 f4 | b,2 d4 c8 b,8 |
    r8 e8 g4 r8 e8 c4 | r8 c8 e4 r8 c8 a,4 | r8 f8 a,4 r8 f8 d4 | e2 g4 f8 e8 |
    r8 g8 b,4 r8 g8 e4 | r8 a,8 c4 r8 a,8 f4 | r8 c8 e4 r8 c8 a,4 | b,2 d4 c8 b,8 |
    r8 e8 g4 r8 e8 c4 | r8 c8 e4 r8 c8 a,4 | r8 b,8 d4 r8 b,8 g4 | e2 g2 |
}

channel 2 bass octave 3 {
    c4. r8 g4. r8 | a,4. r8 e4. r8 | f4. r8 c'4. r8 | g4. r8 d'4. r8 |
    c4. r8 g4. r8 | a,4. r8 e4. r8 | d4. r8 a4. r8 | c4. r8 g4. r8 |
    e4. r8 b4. r8 | f4. r8 c'4. r8 | a,4. r8 e4. r8 | g4. r8 d'4. r8 |
    c4. r8 g4. r8 | a,4. r8 e4. r8 | g4. r8 d'4. r8 | c2 g2 |
}

phrase light_beat { r4 b8 r8 r4 b8 r8 }
channel 3 brush octave 6 { repeat 16 { light_beat | } }
