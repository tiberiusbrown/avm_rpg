// MARKET DAY WALTZ
// Original town-square dance in F major, with lilting three-beat accompaniment.
// 24 measures, four channels, seamless loop.
title "Market Day Waltz"
description "Flower stalls, a fountain, and a leisurely dance across the square."
tempo 102
meter 3/4
loop

envelope waltz_melody { points 0ms:85%, 20ms:100%, 170ms:75% release 75ms:0% curve step }
envelope pizz { points 0ms:100%, 110ms:65%, 230ms:40% release 36ms:0% curve step }
envelope oom { points 0ms:100%, 160ms:70% release 48ms:0% curve step }
envelope soft_tap { points 0ms:100%, 40ms:35%, 80ms:0% curve step }

instrument clarinet { wave pulse duty 25% volume 12 envelope waltz_melody gate 92% }
instrument sweet_bell { wave triangle volume 10 envelope waltz_melody gate 95% }
instrument pizz_strings { wave pulse duty 12.5% volume 5 envelope pizz gate 65% }
instrument round_bass { wave triangle volume 8 envelope oom gate 86% }
instrument footfall { wave noise volume 2 envelope soft_tap gate 60% }

// A 3/4 waltz accompaniment: chord root and third/fifth on the two offbeats.
phrase oom_f  { f4 c'4 a4 | }
phrase oom_c  { c4 g4 e4 | }
phrase oom_d  { d4 a4 f4 | }
phrase oom_bb { bb,4 f4 d4 | }
phrase oom_g  { g4 d'4 bb4 | }
phrase oom_a  { a,4 e4 c'4 | }

phrase pizz_f  { a8 c'8 a8 c'8 a8 c'8 | }
phrase pizz_c  { g8 c'8 g8 e'8 g8 c'8 | }
phrase pizz_d  { a8 d'8 a8 f'8 a8 d'8 | }
phrase pizz_bb { f8 bb8 f8 d'8 f8 bb8 | }
phrase pizz_g  { bb8 d'8 bb8 g'8 bb8 d'8 | }
phrase pizz_a  { e8 a8 e8 c'8 e8 a8 | }
phrase waltz_steps { r4 c'8 r8 c'8 r8 | }
phrase waltz_rest { r2. | }

channel 0 clarinet octave 4 {
    // A: welcoming main tune.
    a4 c'8 a8 f4 |
    g4 e8 g8 c'4 |
    f4 a8 d'8 c'4 |
    d'4 c'8 bb8 a4 |
    a4 c'8 f'8 e'4 |
    d'4 bb8 g8 f4 |
    g4 c'8 e'8 d'4 |
    c'2 r4 |
    // B: rise above the roofs.
    d'4 f'8 d'8 bb4 |
    c'4 a8 c'8 f'4 |
    bb4 d'8 bb8 g4 |
    e'4 d'8 c'8 g4 |
    a4 c'8 a8 f4 |
    a4 f8 d8 f4 |
    bb4 a8 g8 d'4 |
    c'2 r4 |
    // A short bridge on the triangle-wave bell, then the clarinet returns.
    use sweet_bell
    f'4 e'8 d'8 c'4 |
    d'4 c'8 bb8 a4 |
    c'4 a8 f8 a4 |
    g4 e8 g8 c'4 |
    use clarinet
    d'4 bb8 a8 g4 |
    e'4 g8 c'8 e'4 |
    f'2 c'4 |
    f'4 c'4 a4 |
}

channel 1 pizz_strings octave 3 {
    pizz_f pizz_c pizz_d pizz_bb
    pizz_f pizz_g pizz_c pizz_f
    pizz_bb pizz_f pizz_g pizz_c
    pizz_f pizz_d pizz_g pizz_c
    pizz_d pizz_bb pizz_f pizz_c
    pizz_bb pizz_c pizz_f pizz_f
}

channel 2 round_bass octave 3 {
    oom_f oom_c oom_d oom_bb
    oom_f oom_g oom_c oom_f
    oom_bb oom_a oom_g oom_c
    oom_f oom_d oom_g oom_c
    oom_d oom_bb oom_f oom_c
    oom_bb oom_c oom_f oom_f
}

// A little dance-floor texture without a continuous drum pattern.
channel 3 footfall octave 5 {
    repeat 8 { waltz_steps }
    repeat 8 { waltz_steps }
    repeat 4 { waltz_rest }
    repeat 4 { waltz_steps }
}
