// Morning in the Meadow — original pastoral theme for the outdoors, the interiors and the dungeon.
// G major | 4/4 at 76 BPM | 24 bars (75.8 seconds). One quiet style throughout: a breathy pulse
// flute, a rocking harp and slow saw roots. There are no drums.
// The song has its own tune. The Venlor theme (docs/venlor_theme.md) is only quoted, in G, and its
// two halves are far apart:
//   question  pickup D4 | G4-- A4 | D5-- C5 A4        (bars 9-10, over G D)
//   answer    C5 D5 G5 A5 | G5-. D5 G4--              (bars 21-22, over C G)
// The question is left unanswered by the song's own music; the answer, held back until the end,
// is the song's last cadence.
// Form:
//   1-8   A   The song's tune over G Em C D | G Em C D. Its last note is the quotation's pickup.
//   9-16  B   The question, then new music over Em Am D | Am D | Em D that rises toward the return.
//   17-20 A'  The first half of the tune again over G Em C D.
//   21-24 End The answer over C G, whose last G rings into the fading coda.
// Loop at runtime with avm_audio_music_loop(1). Channel 3 stays free.
// Channels 0 and 2 carry the song if an effect borrows channel 1.
// The lead and the harp never rest for a whole beat: each sounding voice adds synthesis interrupt
// time to every 50 Hz frame, and the device test's pause-animation timing check tolerates only
// small steps in that load.

title "Morning in the Meadow"
description "A quiet meadow song: breathy flute, rocking harp, slow roots, with the Venlor theme quoted in two halves"
tempo 76
meter 4/4
volume max
// 16 ms steps keep the vibrato smooth and put every channel's fades on one grid.
automation 16ms

// --- Envelopes --------------------------------------------------------------------

envelope flute_env { points 0ms:0%, 22ms:100%, 220ms:84%, 640ms:68% release 56ms:0% }
// A swell for the long notes: the vibrato rides along.
envelope sing_env  { points 0ms:55%, 500ms:100%, 1500ms:84% release 90ms:0% }
envelope pluck_env { points 0ms:100%, 90ms:58%, 300ms:26% release 40ms:0% }
envelope root_env  { points 0ms:100%, 300ms:62%, 1100ms:40% release 80ms:0% }
envelope fade_env  { points 0ms:100%, 3000ms:20% release 200ms:0% }

// --- Lead (channel 0): a breathy flute ----------------------------------------------

instrument flute {
    wave pulse duty 37.5% volume 14 envelope flute_env gate 92%
}
instrument sing {
    wave pulse duty 37.5% volume 14 envelope sing_env gate 98%
    lfo { target pitch depth 12cents period 200ms }
}
// The last note of the song swells and dies away.
instrument last {
    wave pulse duty 37.5% volume 14 envelope fade_env gate 100%
    lfo { target pitch depth 12cents period 200ms }
}

// --- Harmony (channel 1) and bass (channel 2) ---------------------------------------

instrument harp  { wave pulse duty 25% volume 7 envelope pluck_env gate 90% }
instrument roots { wave saw volume 7 envelope root_env gate 96% }

// --- Lead phrases -------------------------------------------------------------------

// The song's tune, bars 1-4 (G Em C D) and 5-8 (G Em C D).
phrase tune_a {
    g4 b4 d'2@sing |
    e'4 d'4 b2@sing |
    c'4 b4 a4 g4 |
    a2@sing f#4 a4 |
}
phrase tune_b {
    g4 b4 d'4 g'4 |
    e'4. d'8 b2@sing |
    c'4 e'4 d'4 c'4 |
    f#4 a2@sing d4 |
}
// The theme's first half in G (after its D4 pickup), then its second half, exactly.
phrase question {
    g2.@sing a4 |
    d'2@sing c'4 a4 |
}
phrase answer {
    c'4 d'4 g'4 a'4 |
    g'4.@sing d'8 g2@last ~
}

channel 0 flute octave 4 {
    // 1-8 A: the song's tune; its last quarter, D4, is the quotation's pickup
    tune_a tune_b

    // 9-16 B: the question, then new music over Em Am D | Am D | Em D
    question
    g4 b4 e'2@sing |
    e'4 c'4 a4 f#4 |
    e'2@sing c'4 a4 |
    d'2@sing a4 f#4 |
    b4 e'4 g'2@sing |
    f#'4 d'4 a2@sing |

    // 17-20 A': the first half of the tune again
    tune_a

    // 21-24 End: the answer, whose last G rings through bar 23
    answer
    g1@last |
    r1 |
}

// --- Harmony phrases ----------------------------------------------------------------

// Rocking eighths, one chord a bar.
phrase h_g  { g8 b8 d'8 b8 g8 b8 d'8 b8 | }
// The same, ending on D4 so that it stays clear of the quotation's A4 in bar 9.
phrase h_g9 { g8 b8 d'8 b8 g8 b8 d'8 g8 | }
phrase h_em { e8 g8 b8 g8 e8 g8 b8 g8 | }
phrase h_c  { c8 e8 g8 e8 c8 e8 g8 e8 | }
phrase h_d  { d8 f#8 a8 f#8 d8 f#8 a8 f#8 | }
phrase h_am { a8 c'8 e'8 c'8 a8 c'8 e'8 c'8 | }
// The bar that holds Am for two beats and D for two.
phrase h_am_d { a8 c'8 e'8 c'8 d8 f#8 a8 f#8 | }

channel 1 harp octave 3 {
    // 1-8 A: G Em C D | G Em C D
    h_g h_em h_c h_d
    h_g h_em h_c h_d

    // 9-16 B: G D | Em Am_D | Am D | Em D
    h_g9 h_d
    h_em h_am_d h_am h_d h_em h_d

    // 17-20 A': G Em C D
    h_g h_em h_c h_d

    // 21-24 End: C G, then a fading G
    h_c h_g
    h_g
    g8 b8 d'8 b8 g2 |
}

// --- Bass phrases -------------------------------------------------------------------

// Slow roots: a root and a fifth, a half note each.
phrase r_g { g2 d'2 | }
phrase r_em { e2 b2 | }
phrase r_c { c'2 g2 | }
phrase r_d { d2 a2 | }
phrase r_am { a2 e'2 | }

channel 2 roots octave 2 {
    // 1-8 A
    r_g r_em r_c r_d
    r_g r_em r_c r_d

    // 9-16 B
    r_g r_d
    r_em
    a2 d2 |
    r_am r_d r_em r_d

    // 17-20 A'
    r_g r_em r_c r_d

    // 21-24 End
    r_c r_g
    g1 |
    g2 r2 |
}
