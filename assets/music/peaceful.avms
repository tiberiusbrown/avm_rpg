
title "Peaceful Village"
tempo 104
meter 4/4
volume max
automation 8ms

envelope lead_env {
    points 0ms:0%, 12ms:100%, 210ms:85%, 400ms:68%
    release 40ms:0%
}
envelope chord_env {
    points 0ms:100%, 96ms:85%, 220ms:65%
    release 28ms:0%
}
envelope bass_env {
    points 0ms:100%, 160ms:78%
    release 48ms:0%
}
envelope tick_env {
    points 0ms:100%, 12ms:45%, 40ms:0%
}

instrument melody {
    wave pulse duty 25% volume 14
    envelope lead_env gate 90%
}
instrument harmony {
    wave pulse duty 50% volume 8
    envelope chord_env gate 85%
}
instrument bass {
    wave saw volume 10
    envelope bass_env gate 85%
}
instrument footstep {
    wave noise volume 3
    envelope tick_env gate 60%
}

// Melody: opening motif, answer, and return.
channel 0 melody octave 5 {
    d8  g8  a4      b4      a8  g8  |
    f#8 a8  d'4     c'8 b8  a4      |
    b8  g8  e4      g8  a8  b4      |
    g4      e8  d8  e4      r4      |

    d8  g8  a4   b4      d'4 |
    c'8 b8  a4   g8  e8  g4  |
    f#8 a8  d'4  c'8 a8  f#4 |
    g2           b4      g4  |
}

// Harmony: G - D - Em - C - G - C - D - G.
channel 1 harmony octave 3 {
    arpeggio { offsets 0,4,7 step 96ms }
    r8 g8 r4 r8 g8 r4 |
    r8 d8 r4 r8 d8 r4 |

    arpeggio { offsets 0,3,7 step 96ms }
    r8 e8 r4 r8 e8 r4 |

    arpeggio { offsets 0,4,7 step 96ms }
    r8 c8 r4 r8 c8 r4 |
    r8 g8 r4 r8 g8 r4 |
    r8 c8 r4 r8 c8 r4 |
    r8 d8 r4 r8 d8 r4 |
    r8 g8 r4 r8 g8 r4 |
}

// Bass: sustained roots with simple fifths.
channel 2 bass octave 2 {
    g2  d'4 g4  |
    d'2 a4  d'4 |
    e'2 b4  e'4 |
    c'2 g4  c'4 |
    g2  d'4 g4  |
    c'2 g4  c'4 |
    d'2 a4  d'4 |
    g2  d'4 g4  |
}

// Soft ticks on beats two and four.
channel 3 footstep octave 5 {
    repeat 8 { r4 c8 r8 r4 c8 r8 | }
}
