// Where the Light Ends — the game's super creepy special-purpose track.
// No area plays it yet: it was the Hollow Mine's song until the cave got a darker but more
// musical one (cave.avms), and it is kept for a later scene that should truly unsettle. Play it
// with MUSIC_CREEPY.
// D Phrygian and chromatic | 4/4 at 56 BPM | 20 measures (85.7 seconds).
// Form A - B - C - D - E. Every part is slow, and every consonance is spoiled.
//   A (1-4)    Cold. A saw drone on D, a creature breathing in the noise voice,
//              and water drips whose pitches sit a semitone or a tritone from
//              the drone. The wail enters in bar 3 with the "stalker" motif:
//              D held, then Eb-D, then a drop of a tritone to Ab.
//   B (5-8)    Crawl. The bass creeps in 3+3+2 eighths. The motif repeats, then
//              the whole scene slides up a semitone (Eb pedal, E and A in the
//              wail), and a heartbeat starts underneath.
//   C (9-12)   Music box. A limping 3+3+2 lullaby (D F E | D Bb A | C E Eb |
//              D C A) turns over Bb, then A, while a distant rumble swells and
//              a rapid minor second (A and Bb) shivers in the wail's channel.
//   D (13-16)  Descent. The bass walks down D C# C B as the wail climbs
//              chromatically from A5 to D6. The heart doubles its pace, a
//              minor-second growl swells in the harmony voice, and bar 16
//              screams a tritone (F6 over B) with a noise crash, then cuts.
//   E (17-20)  Return. A faint ghost of the motif in the low register,
//              breathing and drips again, and the drone sinks back to D so the
//              loop re-enters on the cold open.
// Loop at runtime with avm_audio_music_loop(1).
// The tune lives in channels 0 and 2, so an effect that borrows channel 1 or 3
// costs the drips, the box and the breath, never the wail or the drone.

title "Where the Light Ends"
description "A super creepy special-purpose track: saw drone, breathing noise, drips, a limping music box and a creeping chromatic climb"
tempo 56
meter 4/4
volume max
// 16 ms steps keep the tremolo and vibrato smooth and put every channel's fades on one grid.
automation 16ms

// --- Bass: the drone and the crawl --------------------------------------------------

// A slow inhale at each attack, a wobbling pitch and a breathing tremolo.
envelope drone_env {
    points 0ms:45%, 900ms:100%, 3500ms:88%
    release 500ms:0%
}
instrument drone {
    wave saw volume 15 envelope drone_env gate 100%
    tremolo { period 2600ms depth 35% }
    lfo { target pitch depth 7cents period 1100ms }
}

// The descent: every bar swells from a half-held level to full, faster and harder.
envelope surge_env {
    points 0ms:55%, 3200ms:100%
    release 200ms:0%
}
instrument surge {
    wave saw volume 10 envelope surge_env gate 100%
    tremolo { period 700ms depth 40% }
    lfo { target pitch depth 10cents period 500ms }
}

envelope crawl_env {
    points 0ms:100%, 140ms:78%, 600ms:42%
    release 160ms:0%
}
instrument crawl { wave saw volume 13 envelope crawl_env gate 85% }

// --- Lead: wails ------------------------------------------------------------------

// A thin 12.5% pulse that trembles, drifts in timbre and sags a third of a semitone.
envelope wail_env {
    points 0ms:0%, 380ms:100%, 1300ms:82%, 2600ms:64%
    release 450ms:0%
}
instrument wail {
    wave pulse duty 12.5% volume 12 envelope wail_env gate 96%
    lfo { target pitch depth 20cents period 320ms }
    lfo { target duty depth 8% period 1400ms wave triangle }
    frequency_slide { delta -35cents over 2400ms }
}

// The same voice for the quick notes of the motif.
envelope wail_s_env {
    points 0ms:0%, 90ms:100%, 500ms:70%
    release 160ms:0%
}
instrument wail_s {
    wave pulse duty 12.5% volume 12 envelope wail_s_env gate 92%
    lfo { target pitch depth 20cents period 320ms }
    lfo { target duty depth 8% period 1400ms wave triangle }
}

// The climb: half notes that open fast and keep trembling.
envelope cry_env {
    points 0ms:0%, 150ms:100%, 1800ms:80%
    release 150ms:0%
}
instrument cry {
    wave pulse duty 12.5% volume 12 envelope cry_env gate 95%
    lfo { target pitch depth 25cents period 220ms }
    lfo { target duty depth 8% period 700ms wave triangle }
}

// The scream: a violent vibrato on the thinnest pulse.
envelope shriek_env {
    points 0ms:70%, 60ms:100%, 1000ms:90%
    release 250ms:0%
}
instrument shriek {
    wave pulse duty 12.5% volume 11 envelope shriek_env gate 90%
    lfo { target pitch depth 70cents period 110ms }
    lfo { target duty depth 10% period 180ms wave triangle }
}

// The echo of the motif in the last bars: quiet, wide, and sinking.
envelope ghost_env {
    points 0ms:0%, 500ms:100%, 1500ms:60%
    release 500ms:0%
}
instrument ghost {
    wave pulse duty 25% volume 7 envelope ghost_env gate 96%
    lfo { target pitch depth 30cents period 400ms }
    frequency_slide { delta -60cents over 2000ms }
}

// A minor second flickering at 23 Hz, swelling over two bars.
envelope shiver_env {
    points 0ms:10%, 8000ms:100%
    release 300ms:0%
}
instrument shiver {
    wave pulse duty 50% volume 6 envelope shiver_env gate 100%
    arpeggio { offsets 0,1 step 44ms }
}

// --- Harmony voice: drips, the music box, the growl ------------------------------------

// Each drip is a short falling tick to a pitch off the drone, and the echo is its quieter
// answer a tone lower. The slide sets the pitch, so the written note only places the drip.
envelope drip_env { points 0ms:100%, 18ms:70%, 70ms:0% }
instrument drip_a {
    wave pulse duty 25% volume 6 envelope drip_env gate 100%
    frequency_slide { from f6 to eb6 over 28ms }
}
instrument drip_b {
    wave pulse duty 25% volume 6 envelope drip_env gate 100%
    frequency_slide { from bb5 to ab5 over 28ms }
}
instrument drip_c {
    wave pulse duty 25% volume 6 envelope drip_env gate 100%
    frequency_slide { from e6 to d6 over 28ms }
}
instrument echo_a {
    wave pulse duty 25% volume 3 envelope drip_env gate 100%
    frequency_slide { from eb6 to d6 over 28ms }
}
instrument echo_c {
    wave pulse duty 25% volume 3 envelope drip_env gate 100%
    frequency_slide { from d6 to c6 over 28ms }
}

// A music box that has gone out of tune: bright plucks and a slowly wandering pitch.
envelope box_env {
    points 0ms:100%, 150ms:62%, 700ms:34%, 1500ms:14%
    release 80ms:0%
}
instrument box {
    wave pulse duty 25% volume 10 envelope box_env gate 92%
    lfo { target pitch depth 14cents period 1500ms }
}

// The low growl of the descent: a minor second flickering at 23 Hz, swelling in every bar.
envelope growl_env {
    points 0ms:15%, 3500ms:100%
    release 200ms:0%
}
instrument growl {
    wave pulse duty 50% volume 7 envelope growl_env gate 100%
    arpeggio { offsets 0,1 step 44ms }
}

// The stinger: D, Eb and Ab in a hard flicker.
envelope cluster_env {
    points 0ms:100%, 900ms:85%
    release 250ms:0%
}
instrument cluster {
    wave pulse duty 25% volume 6 envelope cluster_env gate 90%
    arpeggio { offsets 0,1,6 step 40ms }
}

// --- Noise: breath, heart, rumble, crash --------------------------------------------

// One slow breath per bar: 14 a minute, in over 1.7 seconds and out over 1.8.
envelope breath_env {
    points 0ms:0%, 1700ms:100%, 2300ms:72%, 3500ms:0%
}
instrument breath { wave noise volume 4 envelope breath_env gate 100% }

// Retriggering the same seed every 20 to 26 ms turns the noise into a low rattling boom.
envelope rumble_env {
    points 0ms:0%, 9000ms:55%, 15000ms:100%
    release 1200ms:0%
}
instrument rumble {
    wave noise volume 5 envelope rumble_env gate 100%
    noise_retrigger { every 20ms seed 21 }
}

envelope beat_env { points 0ms:100%, 40ms:60%, 110ms:0% }
instrument heart_lub {
    wave noise volume 6 envelope beat_env gate 100%
    noise_retrigger { every 26ms seed 9 }
}
instrument heart_dub {
    wave noise volume 4 envelope beat_env gate 100%
    noise_retrigger { every 22ms seed 9 }
}

envelope crash_env {
    points 0ms:100%, 200ms:75%, 1800ms:20%
    release 600ms:0%
}
instrument crash { wave noise volume 9 envelope crash_env gate 50% }

// One beat of the resting heart (lub, dub, a long rest) and half a beat of the racing one.
phrase heart { c32@heart_lub r32 c32@heart_dub r8 r32 }
phrase racing { c32@heart_lub r32 c32@heart_dub r32 }

// --- Channel 0: the wail ---------------------------------------------------------------

channel 0 wail octave 5 {
    // A: silence, then the stalker motif: D held, Eb-D, down a tritone to Ab.
    r1 | r1 |
    d2.@wail r4 |
    eb4@wail_s d4@wail_s ab,2@wail |

    // B: the motif again, then up a semitone (E crushes Eb, and A is a tritone from it).
    d2.@wail r4 |
    eb4@wail_s d4@wail_s ab,2@wail |
    eb2.@wail r4 |
    e4@wail_s eb4@wail_s a,2@wail |

    // C: silence for the box, then the shiver that swells under its last two bars.
    r1 | r1 |
    use shiver
    a,1 ~ a,1 |
    use wail

    // D: a chromatic climb, A5 to D6, then the scream on F6.
    a2@cry bb2@cry |
    b2@cry c'2@cry |
    c#'2@cry d'2@cry |
    f'2@shriek r2 |

    // E: the motif's ghost, an octave and more below, then silence for the loop's return.
    octave 4
    d2.@ghost r4 |
    eb4@ghost d4@ghost ab,2@ghost |
    r1 | r1 |
}

// --- Channel 1: drips, music box, growl ---------------------------------------------

channel 1 drip_a octave 6 {
    // A: four drips, irregular, two of them echoed.
    r:5/16 c16@drip_a r:2/16 c16@echo_a r:7/16 |
    r:11/16 c16@drip_b r:4/16 |
    r:3/16 c16@drip_c r:2/16 c16@echo_c r:9/16 |
    r:8/16 c16@drip_a r:7/16 |

    // B: fewer drips, then room for the music box.
    r:13/16 c16@drip_b r:2/16 |
    r:6/16 c16@drip_c r:2/16 c16@echo_c r:6/16 |
    r:9/16 c16@drip_a r:6/16 |
    r1 |

    // C: the music box, over Bb and then over A.
    use box
    octave 5
    d4. f4. e4 |
    d4. bb,4. a,4 |
    c4. e4. eb4 |
    d4. c4. a,4 |

    // D: the growl swells in each bar, then the cluster under the scream.
    use growl
    octave 4
    d1 | d1 | d1 |
    use cluster
    octave 5
    d2 r2 |

    // E: silence after the scream, then the drips come back.
    r1 |
    r:7/16 c16@drip_a r:2/16 c16@echo_a r:5/16 |
    r:12/16 c16@drip_b r:3/16 |
    r:10/16 c16@drip_c r:5/16 |
}

// --- Channel 2: the drone and the crawl ----------------------------------------------

channel 2 drone octave 2 {
    // A: one long breath of D.
    d1 ~ d1 ~ d1 ~ d1 |

    // B: the crawl, three eighths and three and two, on D and then on Eb.
    use crawl
    d8 r8 r8 d'8 r8 r8 d8 r8 |
    d8 r8 r8 d'8 r8 r8 eb8 r8 |
    eb8 r8 r8 eb'8 r8 r8 eb8 r8 |
    eb8 r8 r8 eb'8 r8 r8 d8 r8 |

    // C: Bb, then A, as two held drones.
    use drone
    bb1 ~ bb1 |
    a1 ~ a1 |

    // D: the walk down, a half step a bar, swelling harder each time.
    use surge
    d'1 | c#'1 | c'1 |
    b1 |

    // E: back to the cold D, which the first bar of the loop continues.
    use drone
    d1 ~ d1 ~ d1 ~ d1 |
}

// --- Channel 3: noise ----------------------------------------------------------------

channel 3 octave 4 {
    // A: four breaths.
    c1@breath | c1@breath | c1@breath | c1@breath |

    // B: two breaths, then the heart starts, one beat a beat.
    c1@breath | c1@breath |
    repeat 4 { heart } |
    repeat 4 { heart } |

    // C: a distant rumble that builds through the box's four bars.
    c1@rumble ~ c1@rumble ~ c1@rumble ~ c1@rumble |

    // D: the heart races, then the crash under the scream.
    repeat 8 { racing } |
    repeat 8 { racing } |
    repeat 8 { racing } |
    c1@crash |

    // E: the breathing returns.
    c1@breath | c1@breath | c1@breath | c1@breath |
}
