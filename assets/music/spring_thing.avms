// ===================== FINAL CHANNEL ARRANGEMENT =====================

// Lead — NES pulse 1
channel 0 octave 4 {
    // Introduction
    lead_opening_b lead_opening_c lead_opening_d
    // First statement
    lead_theme_a lead_theme_b lead_theme_c lead_theme_d
    // Second statement
    lead_refrain_a lead_refrain_b lead_refrain_c lead_refrain_d
    // Bridge
    lead_bridge_a lead_bridge_b lead_bridge_c lead_bridge_d
    // Returning theme
    lead_theme_a lead_theme_b lead_theme_c lead_theme_d
    // Closing refrain
    lead_refrain_a lead_refrain_b lead_refrain_c lead_refrain_d
    // Ending / turnaround
    lead_outro
}

// Harmony — NES pulse 2
channel 1 octave 4 {
    // Introduction
    harmony_opening_b harmony_opening_c harmony_opening_d
    // First statement
    harmony_theme_a harmony_theme_b harmony_theme_c harmony_theme_d
    // Second statement
    harmony_refrain_a harmony_refrain_b harmony_refrain_c harmony_refrain_d
    // Bridge
    harmony_bridge_a harmony_bridge_b harmony_bridge_c harmony_bridge_d
    // Returning theme
    harmony_theme_a harmony_theme_b harmony_theme_c harmony_theme_d
    // Closing refrain
    harmony_refrain_a harmony_refrain_b harmony_refrain_c harmony_refrain_d
    // Ending / turnaround
    harmony_outro
}

// Bass — NES triangle bass + tonal drums
channel 2 octave 3 {
    // Introduction
    bass_opening_b bass_opening_c bass_opening_d
    // First statement
    bass_theme_a bass_theme_b bass_theme_c bass_theme_d
    // Second statement
    bass_refrain_a bass_refrain_b bass_refrain_c bass_refrain_d
    // Bridge
    bass_bridge_a bass_bridge_b bass_bridge_c bass_bridge_d
    // Returning theme
    bass_theme_a bass_theme_b bass_theme_c bass_theme_d
    // Closing refrain
    bass_refrain_a bass_refrain_b bass_refrain_c bass_refrain_d
    // Ending / turnaround
    bass_outro
}

// Drums — NES noise percussion
channel 3 octave 4 {
    // Introduction
    drums_opening_b drums_opening_c drums_opening_d
    // First statement
    drums_theme_a drums_theme_b drums_theme_c drums_theme_d
    // Second statement
    drums_refrain_a drums_refrain_b drums_refrain_c drums_refrain_d
    // Bridge
    drums_bridge_a drums_bridge_b drums_bridge_c drums_bridge_d
    // Returning theme
    drums_theme_a drums_theme_b drums_theme_c drums_theme_d
    // Closing refrain
    drums_refrain_a drums_refrain_b drums_refrain_c drums_refrain_d
    // Ending / turnaround
    drums_outro
}
