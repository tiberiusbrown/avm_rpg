// "Spring Thing" — source: spring.ftm, original NES/FamiTracker module.
// 200 BPM, speed 6, 64 sixteenth-note rows per 4-bar frame.
// The original author indicated 0:05.235; the FTM itself jumps to frame 1 at 0:04.800.
// Four audible NES voices: pulse 1, pulse 2, triangle, noise. DPCM unused.
// Readable note/phrase transcription with approximated NES envelopes and effects.
// Notes, pitches, repeated attacks, cut events, and order are retained.
// AVMS phrases/repeats are source readability constructs in today's compiler.

title "Spring Thing — 4.800s loop"
description "NES Spring Thing, readable AVMS transcription; loops"
tempo 200
meter 4/4
automation 16ms


// Instrument envelopes approximate tracker volume-sequence macros.
// They intentionally replace the 60Hz per-frame changes with editable shapes.
envelope quick_tap { points 0ms:100%, 25ms:75%, 50ms:35%, 90ms:0% curve step }
envelope key_decay { points 0ms:95%, 25ms:100%, 50ms:55%, 75ms:35%, 115ms:0% curve step }
envelope medium_decay { points 0ms:100%, 25ms:80%, 65ms:60%, 105ms:42%, 155ms:35% curve step }
envelope long_decay { points 0ms:100%, 40ms:85%, 90ms:65%, 160ms:40%, 260ms:0% curve step }
envelope soft_fade { points 0ms:45%, 120ms:38%, 300ms:22%, 500ms:10%, 1150ms:0% curve step }
envelope hat_decay { points 0ms:100%, 15ms:55%, 35ms:20%, 65ms:0% curve step }
envelope snare_decay { points 0ms:100%, 25ms:80%, 55ms:35%, 100ms:0% curve step }
envelope triangle_tap { points 0ms:100%, 28ms:90%, 65ms:0% curve step }


// All three tonal waveforms are native AVMS synthesis; noise uses channel 3.
// The original FamiTracker instruments are named alongside these equivalents.
instrument triangle_bass { wave triangle volume 13 gate 95% }      // bass
instrument bright_solo  { wave pulse duty 12.5% volume 12 envelope quick_tap } // solo1
instrument key_pluck   { wave pulse duty 25% volume 12 envelope key_decay }    // skey
instrument key_long    { wave pulse duty 25% volume 12 envelope medium_decay } // skey2
instrument solo_long   { wave pulse duty 12.5% volume 12 envelope long_decay lfo { target pitch depth 12cents period 340ms wave sine } } // solo2
instrument solo_fade   { wave pulse duty 12.5% volume 10 envelope soft_fade }  // solo2f
instrument triangle_kick { wave triangle volume 13 envelope triangle_tap }    // tkick
instrument triangle_snare { wave triangle volume 11 envelope triangle_tap }  // tsnare
instrument hat_tap     { wave noise volume 7 envelope hat_decay }  // hat1
instrument hat_soft    { wave noise volume 5 envelope hat_decay }  // hat2
instrument noise_snare { wave noise volume 11 envelope snare_decay } // nsnare


// ==================== REUSABLE FOUR-BAR PATTERNS ====================

// ---- LEAD — original NES channel 0 ----
// FamiTracker pattern 00 — four bars
phrase lead_theme_a {
    r8.
    use solo_long
    volume 13
    f16
    volume 15
    g4 f e8 f4 c2. c8 |
    f4 e8 d4 c d16*10
    use key_pluck
    volume 11
    g,, r g,, r b,, r b, r |
}

// FamiTracker pattern 01 — four bars
phrase lead_theme_b {
    r8
    use key_pluck
    volume 8
    b,
    use solo_long
    volume 15
    g4 f e8 f4 c2 a,8 c e |
    f4 e8 d4 c d16*10
    use key_pluck
    volume 11
    g,, r g,, r b,, r b, r |
}

// FamiTracker pattern 02 — four bars
phrase lead_theme_c {
    r8
    use solo_long
    volume 15
    e, g, c e4. c8 |
    frequency_slide { from c4 to d4 over 189ms curve linear }
    d4
    frequency_slide off
    c b,8 c4 a,2. d,8
    frequency_slide { from d3 to e3 over 133ms curve linear }
    e,
    frequency_slide off
    d, |
    b,2
    use key_pluck
    volume 11
    b,,16 r b,, r g,, r g,, r |
}

// FamiTracker pattern 03 — four bars
phrase lead_theme_d {
    r8
    use solo_long
    volume 15
    g f e f4. e8 |
    frequency_slide { from e4 to f4 over 189ms curve linear }
    f4
    frequency_slide off
    c b,8 c4 f4..
    volume 13
    e16
    volume 15
    f8 e4 b,8
    frequency_slide { from b3 to c4 over 300ms curve linear }
    c4
    frequency_slide off
    volume 13
    c
    volume 11
    c
    volume 9
    c
    volume 7
    c8 |
}

// FamiTracker pattern 04 — four bars
phrase lead_opening_b {
    r4
    use key_pluck
    volume 4
    c,,8 c, e,
    use key_long
