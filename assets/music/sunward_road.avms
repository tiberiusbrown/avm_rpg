title "Sunward Road"
description "A hopeful walking song: an open rising call and a broad, sustained bridge over a soft walking pulse."

// Original composition for AVM RPG; no reference MIDI notes are imported.
// G major, 16 bars in 4/4, A / A' / B / A''. The two-bar refrain
// returns at bars 5 and 13. The lead occupies the upper register; quiet backing
// figures answer its cadential breaths.
tempo 112
meter 4/4
loop
automation 8ms

envelope singing {
    points 0ms:0%, 20ms:100%, 160ms:90%, 600ms:75%
    sustain
    release 48ms:0%
}
envelope plucked {
    points 0ms:0%, 8ms:100%, 64ms:65%, 200ms:40%
    sustain
    release 32ms:0%
}
envelope foundation {
    points 0ms:0%, 16ms:100%, 120ms:85%
    sustain
    release 40ms:0%
}
envelope brushed {
    points 0ms:0%, 4ms:100%, 12ms:30%, 24ms:0%
}
instrument lead { wave triangle volume 16 envelope singing gate 93% }
instrument accompaniment { wave sine volume 4 envelope plucked gate 82% }
instrument bass { wave triangle volume 5 envelope foundation gate 85% }
instrument brush { wave noise volume 1 envelope brushed gate 50% }

phrase road_refrain { b4 d'4 e'2 | d'2. b8 a8 | }

channel 0 lead octave 5 {
    // A: a rising call with a held destination, then a calm answer.
    road_refrain
    b4 g4 a2 | a2. r4 |
    // A': let the call become familiar before changing the cadence.
    road_refrain
    c'2 b4 a4 | g2. r4 |
    // B: the highest G is one sustained arrival, not a run of new notes.
    d'4 g'2. | e'2 d'4 c'4 |
    b4 d'4 c'2 | a2. r4 |
    // A'': return to the original call and resolve the journey to G.
    road_refrain
    c'2 a4 f#4 | g2. r4 |
}

channel 1 accompaniment octave 4 {
    r8 b,8 d4 r8 g8 b,4 | r8 f#8 a,4 r8 f#8 a,4 | r8 b,8 d4 r8 f#8 a,4 | f#2 a,4 g8 f#8 |
    r8 b,8 d4 r8 g8 b,4 | r8 f#8 a,4 r8 f#8 a,4 | r8 e8 g4 r8 f#8 a,4 | b,2 d4 c8 b,8 |
    r8 b,8 d4 r8 b,8 d4 | r8 e8 g4 r8 e8 g4 | r8 b,8 d4 r8 e8 g4 | f#2 a,4 g8 f#8 |
    r8 b,8 d4 r8 g8 b,4 | r8 f#8 a,4 r8 f#8 a,4 | a,2 a,4 f#4 | b,2 d2 |
}

channel 2 bass octave 3 {
    g4 r4 e4 r4 | d4 r4 d4 r4 | g4 r4 d4 r4 | d4 r4 d4 r4 |
    g4 r4 e4 r4 | d4 r4 d4 r4 | c4 r4 d4 r4 | g4 r4 g4 r4 |
    g4 r4 g4 r4 | c4 r4 c4 r4 | g4 r4 c4 r4 | d4 r4 d4 r4 |
    g4 r4 e4 r4 | d4 r4 d4 r4 | d4 r4 d4 r4 | g2 d'2 |
}

phrase light_beat { r4 b8 r8 r4 b8 r8 }
channel 3 brush octave 6 { repeat 16 { light_beat | } }
