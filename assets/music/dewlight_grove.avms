title "Dewlight Grove"
description "A warm woodland song: a falling three-note sigh opens into a held upward fifth, then returns home."

// Original composition for AVM RPG; no reference MIDI notes are imported.
// A-flat major, 16 bars in 4/4, A / A' / B / A''. The two-bar refrain
// returns at bars 5 and 13. The lead occupies the upper register; quiet backing
// figures answer its cadential breaths.
tempo 104
meter 4/4
loop
automation 8ms

envelope singing {
    points 0ms:0%, 16ms:100%, 120ms:95%, 800ms:85%
    sustain
    release 40ms:0%
}
envelope plucked {
    points 0ms:0%, 8ms:100%, 64ms:65%, 200ms:40%
    sustain
    release 32ms:0%
}
envelope foundation {
    points 0ms:0%, 16ms:100%, 120ms:85%
    sustain
    release 40ms:0%
}
envelope brushed {
    points 0ms:0%, 4ms:100%, 12ms:30%, 24ms:0%
}
instrument lead { wave pulse duty 50% volume 18 envelope singing gate 93% }
instrument accompaniment { wave pulse duty 25% volume 13 envelope plucked gate 82% }
instrument bass { wave pulse duty 50% volume 14 envelope foundation gate 85% }
instrument quiet { wave noise volume 0 }

phrase grove_refrain { c'4 bb8 ab8 eb'2 | db'2. c'8 bb8 | }

channel 0 lead octave 5 {
    // A: the same two-bar sigh will return twice, so it can be remembered.
    grove_refrain
    c'4 ab4 bb4 c'4 | bb2. r4 |
    // A': repeat the opening exactly, then give it a gentler answer.
    grove_refrain
    c'4 db'4 eb'2 | c'2. r4 |
    // B: one higher, longer arrival; step back down toward the refrain.
    f'2 eb'4 c'4 | db'2. c'8 bb8 |
    ab4 bb4 c'2 | bb2. r4 |
    // A'': recognize the opening, then finally settle on the tonic.
    grove_refrain
    c'4 bb4 g2 | ab2. r4 |
}

channel 1 accompaniment octave 4 {
    r4 c4 eb2 | r4 f4 ab2 | r4 ab4 c2 | g2 bb,4 ab8 g8 |
    r4 c4 eb2 | r4 f4 ab2 | r4 g4 bb,2 | c2 eb4 db8 c8 |
    r4 ab4 c2 | r4 f4 ab2 | r4 c4 eb2 | g2 bb,4 ab8 g8 |
    r4 c4 eb2 | r4 f4 ab2 | r4 g4 bb,2 | c2 eb2 |
}

channel 2 bass octave 3 {
    ab2 eb'2 | db2 ab2 | f2 c'2 | eb2 bb2 |
    ab2 eb'2 | db2 ab2 | eb2 bb2 | ab2 eb'2 |
    f2 c'2 | db2 ab2 | c2 g2 | eb2 bb2 |
    ab2 eb'2 | db2 ab2 | eb2 bb2 | ab2 eb'2 |
}

channel 3 quiet { r1*16 }
