title "Boss"
description "Closer four-voice adaptation of Boss.ftm: original rhythms, bass pulse, drum groove, and pitch motion."
tempo 120
meter 4/4
automation 8ms

// 17 measures / 34 seconds, matching the original loop.
// The FamiTracker conversion encoded every 16–20 ms volume frame as a note.
// Here genuine note attacks remain separate; their volume decays use envelopes.
// The occasional :N/128 time is a short rhythmic subdivision for tracker swing.
// Each named phrase is one complete 4/4 bar; change the channel arrangement below.

envelope lead_decay {
    points 0ms:100%, 32ms:85%, 64ms:75%, 112ms:60%, 248ms:42%
    curve step
}
envelope counter_decay {
    points 0ms:100%, 32ms:90%, 80ms:70%, 120ms:60%, 250ms:45%
    curve step
}
envelope bass_decay {
    points 0ms:100%, 32ms:85%, 64ms:65%, 112ms:50%
    curve step
}
envelope drum_decay {
    points 0ms:100%, 32ms:75%, 64ms:40%
    curve step
}

// Original voice allocation is important for the timbre:
// 0: 50% pulse lead, 1: 50% pulse counterline, 2: 25% pulse bass,
// 3: pitch-dependent noise percussion.
instrument lead { wave pulse duty 50% volume 20 envelope lead_decay }
instrument lead_vibrato {
    wave pulse duty 50% volume 12 envelope lead_decay
    lfo { target pitch depth 17cents period 256ms wave sine phase note }
}
instrument lead_sustain {
    wave pulse duty 50% volume 9
    lfo { target pitch depth 16cents period 256ms wave sine phase note }
}
instrument counter { wave pulse duty 50% volume 15 envelope counter_decay }
instrument falling_line { wave pulse duty 50% volume 12 }
instrument counter_vibrato {
    wave pulse duty 50% volume 13 envelope counter_decay
    lfo { target pitch depth 16cents period 256ms wave sine phase note }
}
instrument bass { wave pulse duty 25% volume 14 envelope bass_decay }
instrument drum { wave noise volume 7 envelope drum_decay gate 90% }
instrument accent { wave noise volume 9 envelope drum_decay gate 90% }
instrument snap { wave noise volume 5 envelope drum_decay gate 90% }
instrument tick { wave noise volume 4 envelope drum_decay gate 90% }

// ── Lead: opening arpeggios, rising tension, main tune, refrain ──
phrase lead_intro {
    d,32 f, a, c# f, a, c# d a, c# d f c# d f:5/128 c#'64. d32 f a c#' f a c#' d'
    a c#' d' f' c#' d' f':5/128 c#''64. |
}
phrase lead_stabs {
    d''16 d' d'' d' d'' d' d'' d' d'2 |
}
phrase lead_rise {
    d'128 d#'64 e'128 f'64 f#' g' g#' a':11/32 c#' c':35/64 |
}
phrase lead_theme_a {
    d'8 d' e' d' g' f' e' f' |
}
phrase lead_theme_b {
    d'8 d' e' d' g' f' g' g' |
}
phrase lead_theme_c {
    g'4. f'16 e' f'4. e'16 f' |
}
phrase lead_theme_d {
    e'16 d' c'4 a c' a16 c' |
}
phrase lead_theme_e {
    // Original tracker bends C# upward, then glides into D.
    frequency_slide { from 556Hz to 570Hz over 1/16 curve linear }
    c#'16
    frequency_slide { from 572Hz to 587Hz over 1/16 curve linear }
    d'8.
    frequency_slide off
    c'16 d' c' b a8. f a8 |
}
phrase lead_theme_f {
    b8. g e'8 g'8. f' g'8 |
}
phrase lead_refrain_a {
    d4. e16 f e2 |
}
phrase lead_refrain_b {
    f4. g16 a g4 c' |
}
phrase lead_resolution_a {
    d'8. c' d':5/8 |
}
phrase lead_resolution_b {
    g2 a |
}

// ── Counterline phrases ──
phrase counter_riff {
    d,16 d,, f, d,, e, d,, f, d,, g, d,, f, d,, e, d,, f, d,, |
}
phrase counter_answer {
    a,,8 f, e, d,16 g,,8 f, e, f,16 g,8 |
}
phrase counter_drive_a {
    d,16 d,, d,, d, d,, d,, d, d,, f, f,, f,, f, f,, f,, f, f,, |
}
phrase counter_drive_b {
    e,16 e,, e,, e, e,, e,, e, e,, a,8 a, a, a, |
}
phrase counter_sustain_a {
    d,2 e, |
}
phrase counter_sustain_b {
    f,2 g, |
}
phrase counter_outro_a {
    d,8. c, a,, f,,16 f,, f, f,, f,, f, f,, |
}
phrase counter_outro_b {
    e,16 e,, e,, e, e,, e,, e, e,, a,8 a, a, a, |
}

// ── Bass phrases ──
phrase bass_silence {
    r1 |
}
phrase bass_intro_d {
    d,,16 d,, d,, d,, e,, d,, d,, d,, d,, d,, d,, d,, e,, d,, d,, d,, |
}
phrase bass_intro_ag {
    a,,16 a,, a,, a,, a,, a,, a,, g,, g,, g,, g,, g,, g,, g,, g,, g,, |
}
phrase bass_drive_df {
    d,,16 d,, d, d,, d,, d,, d, d,, f,, f,, f, f,, f,, f,, f, f,, |
}
phrase bass_drive_ea {
    e,,16 e,, e, e,, e,, e,, e, e,, a,, a,, a, a,, a,, a,, a, a,, |
}
phrase bass_turn_de {
    d,,16 d,, d, d,, d,, d,, e,, f,, e,, e,, e, e,, e,, e,, e, e,, |
}
phrase bass_turn_fg {
    f,,16 f,, f, f,, f,, f,, g,, a,, g,, g,, g, g,, g,, g,, g, g,, |
}
phrase bass_ending_a {
    d,,8. c,, a,, f,,16 f, f,, f,, f,, f, f,, |
}
phrase bass_ending_b {
    e,,16 e,, e, e,, e,, e,, e, e,, a,, a,, a, a,, a,, a,, a, a,, |
}

// ── Noise percussion phrases ──
phrase drums_open {
    f,32.@drum r:5/64 f,:5/128@drum r:11/128 f,@drum r:5/64 f,:5/128@drum r:11/128
    b,,64.@accent c,@snap c#,64@tick a,,32.@drum r64 b,,32@accent c,64@snap c#,@tick
    a,,32.@drum r64 f,32@accent f#,64@snap g,@tick c#,32@accent c#,@accent c,@accent
    c,@accent b,,@accent c,128@snap b,,64.@accent |
}
phrase drums_groove {
    a,,32.@drum r64 a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick a,,32.@drum
    r64 a,,32.@drum r64 a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick a,,:5/128@drum
    a,,64.@drum a,,32.@drum r64 a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick
    a,,32.@drum r64 a,,32.@drum r64 a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick
    a,,:5/128@drum a,,64.@drum |
}
phrase drums_fill {
    a#,,64.@accent b,,@snap c,64@tick a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick
    a,,32.@drum r64 a,,32.@drum r64 a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick
    a,,:5/128@drum a,,64.@drum a,,32.@drum r64 a#,,32@accent b,,64.@snap c,128@tick
    a#,,32@accent b,,64@snap c,@tick a#,,32@accent b,,64.@snap c,128@tick a,,32.@drum
    r64 a#,,32@accent b,,64.@snap c,128@tick a#,,32@accent b,,64@snap c,@tick a,,:5/128@drum
    a,,64.@drum |
}
phrase drums_bridge_a {
    a#,,64.@accent b,,@snap c,64@tick a,,32.@drum r64 a,,:5/128@drum r64. a,,32.@drum
    r64 a#,,32@accent b,,64@snap c,@tick a,,32.@drum r64 a,,:5/128@drum r64. a,,32.@drum
    r64 a#,,64.@accent b,,@snap c,64@tick a,,32.@drum r64 a,,:5/128@drum r64. a,,32@drum
    a,,@drum a#,,@accent b,,64@snap c,@tick a,,32.@drum r64 a,,:5/128@drum r64.
    a,,32.@drum r64 |
}
phrase drums_bridge_b {
    a#,,64.@accent b,,@snap c,64@tick a,,32.@drum r64 a,,:5/128@drum r64. a,,32.@drum
    r64 a#,,32@accent b,,64@snap c,@tick a,,32.@drum r64 a,,:5/128@drum r64. a,,:5/128@drum
    a,,@drum a#,,@accent b,,@snap c,64@tick a,,32.@drum r64 a,,:5/128@drum r64.
    a,,32@drum a,,@drum a,,32.@drum r64 a,,32.@drum r64 a#,,32@accent b,,64@snap
    c,@tick a,,32.@drum r64 |
}
phrase drums_bridge_c {
    a#,,64.@accent b,,@snap c,64@tick a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick
    a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick a,,32.@drum r64 a#,,32@accent
    b,,64@snap c,@tick a,,32.@drum r64 a#,,64.@accent b,,@snap c,64@tick a,,32.@drum
    r64 a#,,32@accent b,,64@snap c,@tick a,,32@drum a,,@drum a#,,@accent b,,64@snap
    c,@tick a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick a,,32.@drum r64 |
}
phrase drums_bridge_d {
    a#,,64.@accent b,,@snap c,64@tick a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick
    a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick a,,32.@drum r64 a#,,32@accent
    b,,64@snap c,@tick a,,:5/128@drum a,,64.@drum a#,,@accent b,,@snap c,64@tick
    a#,,32@accent b,,64.@snap c,128@tick a#,,32@accent b,,64@snap c,@tick a#,,32@accent
    b,,64.@snap c,128@tick a#,,32@accent b,,64@snap c,@tick a#,,32@accent a#,,@accent
    a#,,@accent a#,,@accent a#,,@accent b,,128@snap a#,,64.@accent |
}
phrase drums_ending_fill {
    a#,,64.@accent b,,@snap c,:5/64@tick a,,:5/128@drum r a#,,32@accent b,,64.@snap
    c,:9/128@tick a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick a,,:5/128@drum
    a,,64.@drum a,,32.@drum r64 a,,32.@drum r64 a#,,32@accent b,,64@snap c,@tick
    a#,,32@accent b,,64.@snap c,128@tick a#,,32@accent b,,64@snap c,@tick a#,,32@accent
    b,,64.@snap c,128@tick a#,,32@accent b,,64@snap c,@tick a#,,32@accent b,,128@snap
    a,,64.@drum |
}

// ── Arrangement: all four tracks play concurrently ──

channel 0 lead octave 4 {
    lead_intro                          // 1: D-minor ascending runs
    lead_stabs                          // 2: D5/D6 octave calls
    use lead_vibrato
    lead_rise                           // 3: chromatic climb and sustained tones
    use lead
    lead_theme_a lead_theme_b           // 4-5
    use lead_vibrato
    lead_theme_c                       // 6: gently bent longer tones
    use lead
    lead_theme_d lead_theme_e lead_theme_f // 7-9
    repeat 2 { lead_refrain_a lead_refrain_b } // 10-13
    use lead_sustain
    repeat 2 { lead_resolution_a lead_resolution_b } // 14-17
}

channel 1 counter octave 4 {
    r2
    use falling_line
    glissando { direction down step 1semitone every 32ms to d2 }
    e2
    glissando off                       // 1: descending chromatic run
    use counter
    repeat 2 { counter_riff counter_answer } // 2-5
    repeat 2 { counter_drive_a counter_drive_b } // 6-9
    use counter_vibrato
    repeat 2 { counter_sustain_a counter_sustain_b } // 10-13
    use counter
    repeat 2 { counter_outro_a counter_outro_b } // 14-17
}

channel 2 bass octave 4 {
    bass_silence
    repeat 2 { bass_intro_d bass_intro_ag } // 2-5
    repeat 2 { bass_drive_df bass_drive_ea } // 6-9
    repeat 2 { bass_turn_de bass_turn_fg } // 10-13
    repeat 2 { bass_ending_a bass_ending_b } // 14-17
}

channel 3 drum octave 4 {
    drums_open
    repeat 2 { drums_groove drums_fill } // 2-5
    repeat 4 { drums_groove }            // 6-9
    drums_bridge_a drums_bridge_b drums_bridge_c drums_bridge_d // 10-13
    drums_ending_fill drums_groove       // 14-15
    drums_ending_fill drums_groove       // 16-17
}
