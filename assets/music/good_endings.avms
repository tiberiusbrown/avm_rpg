// Cleaned Good Endings MIDI: no synth pad; all source tracks considered. Track numbers are zero-based.
// Track 1 glockenspiel lead; remaining glockenspiel/lute/horn/viola accompaniment; track 3 electric bass.
// Trimmed empty end-of-track tail; final 8ms reserved for clean note-off before the 172s loop boundary.
// Generated by midi_to_avms.py; physical voices: 0 lead, 1 harmony, 2 bass, 3 noise.
title "Good Endings"
tempo 120
meter 4/4
automation 16ms
loop
// Explicit absolute-boundary timings preserve the source tempo map.

envelope melody_env { points 0ms:100%, 64ms:88% release 8ms:0% curve linear }
instrument melody { wave pulse duty 64 volume 10 envelope melody_env }

envelope harmony_env { points 0ms:100%, 96ms:70% release 8ms:0% curve linear }
instrument harmony { wave pulse duty 32 volume 12 envelope harmony_env }

envelope bass_env { points 0ms:100%, 80ms:82% release 8ms:0% curve linear }
instrument bass { wave pulse duty 128 volume 8 envelope bass_env }

