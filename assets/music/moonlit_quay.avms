title "Moonlit Quay"
description "A still, yearning night song: two held notes make the central gesture, with a quiet lower-tonic answer."

// Original composition for AVM RPG; no reference MIDI notes are imported.
// D minor, 16 bars in 4/4, A / A' / B / A''. The two-bar refrain
// returns at bars 5 and 13. The lead occupies the upper register; quiet backing
// figures answer its cadential breaths.
tempo 90
meter 4/4
loop
automation 8ms

envelope singing {
    points 0ms:0%, 16ms:100%, 120ms:95%, 800ms:85%
    sustain
    release 40ms:0%
}
envelope plucked {
    points 0ms:0%, 8ms:100%, 64ms:65%, 200ms:40%
    sustain
    release 32ms:0%
}
envelope foundation {
    points 0ms:0%, 16ms:100%, 120ms:85%
    sustain
    release 40ms:0%
}
envelope brushed {
    points 0ms:0%, 4ms:100%, 12ms:30%, 24ms:0%
}
instrument lead { wave pulse duty 25% volume 21 envelope singing gate 93% }
instrument accompaniment { wave pulse duty 25% volume 2 envelope plucked gate 82% }
instrument bass { wave pulse duty 50% volume 4 envelope foundation gate 85% }
instrument quiet { wave noise volume 0 }

phrase quay_refrain { a2 d'2 | c'2. a4 | }

channel 0 lead octave 5 {
    // A: the opening needs only two held notes to establish its longing.
    quay_refrain
    bb4 a4 g2 | a2. r4 |
    // A': repeat that gesture before the first low, restful arrival.
    quay_refrain
    bb2 a4 f4 | d2. r4 |
    // B: a single high F carries the lift; the rest is a gentle descent.
    f'2. e'4 | d'2 c'4 a4 |
    bb2 d'4 c'4 | c#'2. r4 |
    // A'': the last dominant gives the low tonic a sense of release.
    quay_refrain
    g2 e4 c#4 | d2. r4 |
}

channel 1 accompaniment octave 4 {
    r2 f4 a,4 | r2 a,4 c4 | r2 bb,4 d4 | c#2 e4 d8 c#8 |
    r2 f4 a,4 | r2 a,4 c4 | r2 bb,4 d4 | f2 a,4 g8 f8 |
    r2 a,4 c4 | r2 f4 a,4 | r2 bb,4 d4 | c#2 e4 d8 c#8 |
    r2 f4 a,4 | r2 a,4 c4 | r2 c#4 e4 | f2 a,2 |
}

channel 2 bass octave 3 {
    d1 | f1 | g1 | a2 e'2 |
    d1 | f1 | g1 | d2 a2 |
    f2 c'2 | d2 a2 | g2 d'2 | a2 e'2 |
    d1 | f1 | a1 | d2 a2 |
}

channel 3 quiet { r1*16 }
