title "Homeward Stars"
description "A broad, consoling homecoming song: a held upward fourth slowly descends to the low tonic."

// Original composition for AVM RPG; no reference MIDI notes are imported.
// E-flat major, 16 bars in 4/4, A / A' / B / A''. The two-bar refrain
// returns at bars 5 and 13. The lead occupies the upper register; quiet backing
// figures answer its cadential breaths.
tempo 100
meter 4/4
loop
automation 8ms

envelope singing {
    points 0ms:0%, 16ms:100%, 120ms:95%, 800ms:85%
    sustain
    release 40ms:0%
}
envelope plucked {
    points 0ms:0%, 8ms:100%, 64ms:65%, 200ms:40%
    sustain
    release 32ms:0%
}
envelope foundation {
    points 0ms:0%, 16ms:100%, 120ms:85%
    sustain
    release 40ms:0%
}
envelope brushed {
    points 0ms:0%, 4ms:100%, 12ms:30%, 24ms:0%
}
instrument lead { wave pulse duty 50% volume 18 envelope singing gate 93% }
instrument accompaniment { wave pulse duty 25% volume 3 envelope plucked gate 82% }
instrument bass { wave pulse duty 50% volume 5 envelope foundation gate 85% }
instrument quiet { wave noise volume 0 }

phrase stars_refrain { bb4 eb'2 d'4 | c'2 bb2 | }

channel 0 lead octave 5 {
    // A: climb once, hold the arrival, and let the answer come down slowly.
    stars_refrain
    ab4 bb4 c'2 | d'2. r4 |
    // A': the same opening now descends all the way to the home note.
    stars_refrain
    ab2 g4 f4 | eb2. r4 |
    // B: the high G is the broad crest of the whole melody.
    g'2 f'4 eb'4 | d'2. c'4 |
    bb4 c'4 d'2 | bb2. r4 |
    // A'': familiar words, a new final cadence, and a breath before return.
    stars_refrain
    ab4 bb4 g2 | eb2. r4 |
}

channel 1 accompaniment octave 4 {
    g2 bb,4 g4 | eb2 g4 eb4 | c2 eb4 c4 | d2 f4 eb8 d8 |
    g2 bb,4 g4 | eb2 g4 eb4 | ab2 c4 ab4 | g2 bb,4 ab8 g8 |
    g2 bb,4 g4 | bb,2 d4 bb,4 | d2 f4 d4 | d2 f4 eb8 d8 |
    g2 bb,4 g4 | eb2 g4 eb4 | d2 f4 d4 | g2 bb,2 |
}

channel 2 bass octave 3 {
    eb2 bb2 | c2 g2 | ab2 eb'2 | bb2 f'2 |
    eb2 bb2 | c2 g2 | f2 c'2 | eb2 bb2 |
    eb2 bb2 | bb2 f'2 | d2 a2 | bb2 f'2 |
    eb2 bb2 | c2 g2 | bb2 f'2 | eb2 bb2 |
}

channel 3 quiet { r1*16 }
