title "Venus"
description "Condensed arrangement of Venus.ftm: C-minor arpeggios, swelling chords, and pulsing bass."
tempo 150
meter 4/4

// One bar is 1.6 seconds. The 16ms tracker volume frames were replaced by
// envelopes and gate lengths. The Cm / Gm / Ab / Fm progression is retained.

envelope bright_pluck {
    points 0ms:100%, 100ms:90%, 200ms:78%
    release 36ms:0%
    curve step
}

envelope swelling_pad {
    points 0ms:20%, 400ms:55%, 800ms:80%, 1200ms:100%
    release 80ms:0%
    curve step
}

envelope bass_pluck {
    points 0ms:100%, 100ms:75%, 160ms:50%
    release 24ms:0%
    curve step
}

instrument pluck {
    wave pulse duty 50% volume 16 envelope bright_pluck gate 90%
}
instrument lyrical {
    wave pulse duty 50% volume 16 envelope bright_pluck gate 96%
    lfo { target pitch depth 10cents period 400ms }
}
instrument pad {
    wave pulse duty 50% volume 10 envelope swelling_pad gate 95%
}
instrument bass {
    wave pulse duty 25% volume 17 envelope bass_pluck gate 92%
}
instrument kick  { wave noise volume 7 gate 50% }
instrument hat   { wave noise volume 4 gate 42% }
instrument rim   { wave noise volume 5 gate 48% }

// -- Arpeggiated intro (relative to octave 4) --

phrase arp_cm { repeat 4 { c'16 g16 d#16 c16 } | }
phrase arp_gm { repeat 4 { g16 d16 a#,16 g,16 } | }
phrase arp_ab { repeat 4 { g#16 d#16 a#,16 g#,16 } | }
phrase arp_fm { repeat 4 { f16 c16 g#,16 f,16 } | }

// -- Lyrical variation: the same chord cycle with longer note values --

phrase melody_cm { c'4 d'8 d#'4 d'8 c'8 a#8 | }
phrase melody_gm { g4 a#8 d4 a#8 d4 | }
phrase melody_ab { d#8 f8 g#4. g8 g#8 a#8 | }
phrase melody_fm { c'2 b2 | }
phrase melody_final { d#'2 f'2 | }

// -- Bass ostinati (relative to octave 2) --

phrase bass_cm { c8 c c' c c c c' c | }
phrase bass_gm { g,8 g, g g, g, g, g g, | }
phrase bass_ab { g#,8 g#, g# g#, g#, g#, g# g#, | }
phrase bass_fm { f,8 f, f f, f, f, f f, | }

// -- Gentle electronic percussion, each phrase one bar --

phrase drums_a {
    c,8@kick d#8@hat e8@hat f8@rim
    c,8@kick d#8@hat e8@hat f8@rim |
}
phrase drums_b {
    c,8@kick d#8@hat f8@rim d#8@hat
    c,8@kick d#8@hat f8@rim d#8@hat |
}
phrase drums_fill {
    c,8@kick d#8@hat f8@rim d#8@hat
    c,8@kick f16@rim f#16@rim e8@hat f8@rim |
}

// -- Channel arrangement --

channel 0 pluck octave 4 {
    repeat 2 { arp_cm arp_gm arp_ab arp_fm } // 1-8: Sparkling ostinato

    use lyrical
    melody_cm melody_gm melody_ab melody_fm // 9-12: Songful bridge
    melody_cm melody_gm melody_ab melody_final // 13-16: Rising ending
}

channel 1 pad octave 4 {
    repeat 4 { c'1 | g1 | g#1 | f1 | } // Swelling harmonic foundation
}

channel 2 bass octave 2 {
    repeat 4 { bass_cm bass_gm bass_ab bass_fm }
}

channel 3 kick octave 4 {
    repeat 4 { drums_a drums_b drums_b drums_fill }
}
