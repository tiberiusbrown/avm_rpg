// Cave — readable AVMS arrangement of Cave.ftm (FamiTracker / NES 2A03)
//
// Original arrangement: 10 frames x 64 rows, speed 6, tempo 150.
// Each tracker row is one sixteenth note; the 40-bar loop lasts 64 seconds.
// Pulse 1 / Pulse 2 / Triangle / Noise map to AVM channels 0 / 1 / 2 / 3.
// The unused DPCM channel contains no samples.
//
// Long sections are intentionally described as reusable musical phrases.
// In particular, the fast repeated notes are *retriggered*, not flattened
// into sustained notes with an arpeggio, to retain their attack rhythm.

title "Cave"
description "NES cave atmosphere: echoing pulses, restless chromatic piano, sparse bass, and low percussion"
tempo 150
meter 4/4
automation 16ms

// ------------------------------ Instruments ------------------------------

// FamiTracker lead: pulse duty 2 (50%), descending volume sequence.
envelope lead_decay {
    points 0ms:100%, 32ms:80%, 64ms:60%, 96ms:40%, 128ms:25%, 176ms:0%
    curve step
}

// FamiTracker piano: slower decay toward a sustained level.
envelope piano_decay {
    points 0ms:100%, 48ms:93%, 80ms:79%, 112ms:64%, 144ms:57%
    curve step
}

// Original drum sequence falls from 9/15 to silence in about 133 ms.
envelope drum_decay {
    points 0ms:100%, 32ms:78%, 64ms:56%, 96ms:33%, 144ms:0%
    curve step
}

// The original bass gates its triangle note for six tracker ticks out of
// a fourteen-tick sequence. Square tremolo gives a compact approximation.
effect bass_gate {
    tremolo { period 232ms depth 100% wave square phase note }
}

// The NES piano instrument repeats: 0,0,0,+7,+7,+7,+4,+4,+4 semitones.
// AVMS arpeggio changes pitch without consuming additional score notes.
effect piano_arp {
    arpeggio { offsets 0,0,0,7,7,7,4,4,4 step 16ms repeat }
}

instrument lead {
    wave pulse duty 50% volume 12 envelope lead_decay gate 100%
}
instrument lead_quiet {
    wave pulse duty 50% volume 9 envelope lead_decay gate 100%
}
instrument echo {
    wave pulse duty 50% volume 8 envelope lead_decay gate 100%
}
instrument piano {
    wave pulse duty 12.5% volume 11 envelope piano_decay gate 100%
    effects piano_arp
}
instrument bass {
    wave triangle volume 12 gate 100% effects bass_gate
}
instrument bass_wobble {
    wave triangle volume 12 gate 100% effects bass_gate
    lfo { target pitch depth 16cents period 200ms wave triangle }
}
instrument triangle_piano {
    wave triangle volume 11 envelope piano_decay gate 100%
    effects piano_arp
}
instrument kick  { wave noise volume 9  envelope drum_decay gate 100% }
instrument snare { wave noise volume 11 envelope drum_decay gate 100% }
instrument tick  { wave noise volume 6  envelope drum_decay gate 100% }

// ---------------------------- Shared ostinatos ---------------------------

// Opening pulse figure. The second bar is intentionally almost empty;
// the short lead envelope does not sustain through these written rests.
phrase low_spaced_half {
    c8 d8 d'8 c8 d8 d'8 r4 |
    r1 |
}

// Same notes in a relentless eighth-note pattern, crossing bar boundaries.
// 10 repetitions = 60 sixteenths; the last two eighths finish frame 1/3.
phrase low_busy_four {
    repeat 10 { c8 d8 d'8 }
    c8 d8 |
}

// Pulse 2 echoes Pulse 1 one tracker row (one sixteenth) later.
phrase echo_spaced_half {
    r16 c8 d8 d'8 c8 d8 d'8 r8. |
    r1 |
}
phrase echo_busy_four {
    r16 repeat 10 { c8 d8 d'8 }
    c8 d16 |
}

// The late-section ostinato retriggers on every tracker row. Each second
// attack is softer, as in the original alternating 0A/08 volume column.
phrase quick_triplet {
    d16 d16@lead_quiet
    f16 f16@lead_quiet
    g16 g16@lead_quiet
}
phrase quick_four {
    repeat 10 { quick_triplet }
    d16 d16@lead_quiet f16 f16@lead_quiet |
}

// Two contrasting four-bar passages for the piano voice.
// The first is the A#–A chromatic ostinato with a swell and diminuendo.
// Its 27 individual attacks are retained; only the volume automation is
// simplified to a handful of changes.
phrase whisper_swell {
    r1 | r1 |
    volume 3  repeat 2 { a#16 a16 }
    volume 6  repeat 2 { a#16 a16 }
    volume 10 repeat 2 { a#16 a16 }
    volume 14 repeat 2 { a#16 a16 } |
    volume 11 repeat 2 { a#16 a16 }
    volume 7  repeat 2 { a#16 a16 }
    volume 3  a#16 a16 a#16
    r4 r16 |
}

// The second chromatic build first alternates D/C, then D#/D, and finally
// makes a falling C#/C and D/C cadence.
phrase whisper_rush {
    r1 |
    volume 3  repeat 2 { d16 c16 }
    volume 6  repeat 2 { d16 c16 }
    volume 10 repeat 2 { d16 c16 }
    volume 12 repeat 2 { d16 c16 } |
    repeat 8 { d#16 d16 } |
    volume 11 repeat 2 { c#16 c16 }
    volume 8  repeat 2 { c#16 c16 }
    volume 6  repeat 2 { d16 c16 }
    volume 4  repeat 2 { d16 c16 } |
}

// Bass begins each entry with two very short pickup stabs, then moves
// into sparse sustained tones. The gated triangle instrument supplies
// the rhythmic movement without expanding note-by-note volume commands.
phrase bass_pickup_c {
    r1 | r1 | r1 |
    r2 r4 c16 r16 c16 r16 |
}
phrase bass_pickup_f {
    r1 | r1 | r1 |
    r2 r4 f16 r16 f16 r16 |
}
phrase bass_low_answer {
    d1 | e1@bass_wobble | a,:2 |
}
phrase bass_high_answer {
    d1 | e1@bass_wobble | a:2 |
}
phrase bass_dark_turn {
    d:2@triangle_piano |
    d#1 c#1 |
}

// One four-bar noise drum phrase runs beneath every frame unchanged.
phrase cave_drums {
    f#2@kick d#'2@snare |
    d#'2@snare d#'2@snare |
    f#2@kick d#'2@snare |
    d#'2@snare d#'4@snare c'8@tick c'8@tick |
}

// ------------------------------ Four voices -----------------------------

channel 0 lead octave 1 {
    // Frames 0–3: spacious lead alternating with continuous eighth notes.
    repeat 2 {
        repeat 2 { low_spaced_half }
        low_busy_four
    }

    // Frames 4–5: the spacious opening idea returns twice.
    repeat 4 { low_spaced_half }

    // Frames 6–9: brighter, faster D–F–G ostinato.
    octave 2
    repeat 4 { quick_four }
}

channel 1 echo octave 1 {
    // Opening call-and-response, exactly one sixteenth behind channel 0.
    repeat 2 {
        repeat 2 { echo_spaced_half }
        echo_busy_four
    }
    repeat 4 { echo_spaced_half }

    // The piano instrument introduces its original +7/+4 arpeggio macro.
    use piano
    octave 2
    repeat 2 {
        whisper_swell
        octave 3
        whisper_rush
        octave 2
    }
}

channel 2 bass octave 3 {
    // Frames 0–5: two pickup gestures, two sustained answers, one full
    // frame of silence, and a final pair of F pickups.
    bass_pickup_c
    bass_low_answer
    bass_pickup_c
    bass_high_answer
    repeat 4 { r1 | }
    bass_pickup_f

    // Frames 6–9: held G2 alternates with descending chromatic harmony.
    repeat 2 {
        g,:4 |
        bass_dark_turn
    }
}

channel 3 kick octave 1 {
    repeat 10 { cave_drums }
}
