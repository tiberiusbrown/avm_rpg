// Stone and Shadow — the cave theme for the Hollow Mine.
// E minor | 4/4 at 68 BPM | 26 bars (91.8 seconds). Dark and foreboding, but a real song: a
// slow march with a singable tune, honest chords and a steady bass. Nothing is spoiled on purpose:
// the only tension is the dominant (a B chord with its raised third, D#) that the tune leans on
// and then lets go. The unsettling special-purpose track that used to be the cave's song is
// creepy.avms.
//   Intro (1-2)   A drone on E swells, a distant bell tolls E and B, and one drum answers. The
//                 last beat is a short roll into the tune.
//   A (3-10)      The tune, a pulse "horn" on a 50% square: two four-bar phrases. The first
//                 (Em C | Am B) climbs to F# and leaves D# hanging over the dominant; the second
//                 (Em C | D Em) answers it and walks down to a low E. A slow shimmering harmony
//                 voice outlines each chord, the bass tolls roots and fifths, and a deep drum
//                 marks beats one and three.
//   B (11-18)     A glimmer in the cavern: over C G | Am Em | C G | B B the lead climbs in a
//                 brighter, ringing voice to B5, a plucked descending arpeggio drips beneath it
//                 like water, and the drums and bass start to march. The last two bars lean
//                 on the dominant with a pounding bass and a growing roll.
//   A' (19-26)    The tune again, fuller: a brighter horn, a marching bass of roots and fifths
//                 in quarter notes and busier drums. The last E fades into the drone of the
//                 intro, so the loop re-enters on its cold open.
// Loop at runtime with avm_audio_music_loop(1).
// Channels 0 and 2 (lead and bass) carry the song if an effect borrows channel 1 or 3: the tune
// and the roots and fifths still make a complete piece without the harmony and the drums.

title "Stone and Shadow"
description "A dark, foreboding cave march: a low drone, a tolling bell and distant drums under a slow minor tune, with a brief glimmer in the middle"
tempo 68
meter 4/4
volume max
// 16 ms steps keep the vibrato smooth and put every channel's fades on one grid.
automation 16ms

// --- Lead (channel 0) ----------------------------------------------------------------

// The horn: a soft attack that settles, so short notes sound connected.
envelope horn_env  { points 0ms:55%, 50ms:100%, 380ms:82% release 110ms:0% }
// Long notes swell, and the vibrato rides along.
envelope moan_env  { points 0ms:45%, 650ms:100%, 1700ms:84% release 160ms:0% }
// B section: a ringing note that decays, as a struck crystal would.
envelope glint_env { points 0ms:100%, 160ms:76%, 1300ms:46% release 140ms:0% }
envelope flow_env  { points 0ms:85%, 24ms:100%, 220ms:82% release 50ms:0% }
// The very last note swells once, then dies away into the drone.
envelope last_env  { points 0ms:55%, 600ms:100%, 1800ms:62%, 3300ms:24% release 200ms:0% }

instrument horn {
    wave pulse duty 50% volume 13 envelope horn_env gate 94%
}
instrument moan {
    wave pulse duty 50% volume 13 envelope moan_env gate 98%
    lfo { target pitch depth 14cents period 230ms }
}
instrument flow {
    wave pulse duty 25% volume 12 envelope flow_env gate 96%
}
instrument glint {
    wave pulse duty 25% volume 12 envelope glint_env gate 100%
    lfo { target pitch depth 10cents period 210ms }
}
// The return of the tune: the same horn with a brighter, thinner pulse and a little more level.
instrument horn2 {
    wave pulse duty 37.5% volume 14 envelope horn_env gate 94%
}
instrument moan2 {
    wave pulse duty 37.5% volume 14 envelope moan_env gate 98%
    lfo { target pitch depth 16cents period 220ms }
}
instrument last {
    wave pulse duty 37.5% volume 14 envelope last_env gate 100%
    lfo { target pitch depth 16cents period 220ms }
}

// --- Harmony (channel 1): bell, shimmering chords, dripping arpeggio ---------------------

// A distant bell: a thin pulse that rings and fades.
envelope toll_env  { points 0ms:100%, 120ms:55%, 1800ms:12% release 400ms:0% }
instrument toll {
    wave pulse duty 12.5% volume 8 envelope toll_env gate 100%
    lfo { target pitch depth 6cents period 120ms }
}
instrument toll2 {
    wave pulse duty 12.5% volume 5 envelope toll_env gate 100%
    lfo { target pitch depth 6cents period 120ms }
}

// A quiet, slowly turning chord, one per bar: minor and major triads, 140 ms per note.
envelope pad_env   { points 0ms:60%, 350ms:100% release 120ms:0% }
// The last chord of the song fades.
envelope pad_end_env { points 0ms:100%, 3200ms:18% release 200ms:0% }
instrument pad_m {
    wave pulse duty 50% volume 5 envelope pad_env gate 100%
    arpeggio { offsets 0,3,7 step 140ms }
}
instrument pad_M {
    wave pulse duty 50% volume 5 envelope pad_env gate 100%
    arpeggio { offsets 0,4,7 step 140ms }
}
instrument pad_end {
    wave pulse duty 50% volume 5 envelope pad_end_env gate 100%
    arpeggio { offsets 0,3,7 step 140ms }
}

// The drip in the B section: a plucked arpeggio that falls and rises again.
envelope pluck_env { points 0ms:100%, 80ms:55%, 260ms:24% release 40ms:0% }
instrument drip { wave pulse duty 25% volume 7 envelope pluck_env gate 85% }

// --- Bass (channel 2): saw -------------------------------------------------------------

// A deep pluck for the tolling roots and fifths.
envelope bass_env  { points 0ms:100%, 140ms:78%, 700ms:52% release 120ms:0% }
// The drone swells in over the intro and again at the end of the loop.
envelope drone_env { points 0ms:50%, 1200ms:100%, 3600ms:90% release 400ms:0% }
// A firmer, shorter note for the march.
envelope march_env { points 0ms:100%, 90ms:80%, 300ms:58% release 60ms:0% }

instrument bass  { wave saw volume 11 envelope bass_env gate 96% }
instrument drone { wave saw volume 11 envelope drone_env gate 100% }
instrument march { wave saw volume 12 envelope march_env gate 88% }

// --- Percussion (channel 3): noise ----------------------------------------------------

// A low drum: retriggering the same seed every 24 to 26 ms turns the noise into a boom.
envelope boom_env  { points 0ms:100%, 50ms:78%, 320ms:30% release 160ms:0% }
envelope tap_env   { points 0ms:100%, 22ms:40%, 50ms:0% }
// A short roll into the next section, and a long one that grows over a whole bar.
envelope fill_env  { points 0ms:20%, 780ms:100% release 16ms:0% }
envelope riser_env { points 0ms:12%, 3300ms:100% release 16ms:0% }

instrument boom {
    wave noise volume 9 envelope boom_env gate 100%
    noise_retrigger { every 24ms seed 9 }
}
instrument thud {
    wave noise volume 5 envelope boom_env gate 100%
    noise_retrigger { every 26ms seed 9 }
}
instrument tap { wave noise volume 3 envelope tap_env gate 100% }
instrument fill {
    wave noise volume 5 envelope fill_env gate 100%
    noise_retrigger { every 20ms seed 37 }
}
instrument roll {
    wave noise volume 6 envelope riser_env gate 100%
    noise_retrigger { every 16ms seed 37 }
}

// --- Channel 0: the tune ----------------------------------------------------------------

// The tune is the same in A and A'. Chords: Em C | Am B, then Em C | D Em.
phrase tune_1 {
    b2@moan e'4. d'8 |
    c'4. b8 g2@moan |
    a4. c'8 e'2@moan |
    f#'2.@moan d#'4 |
}
phrase tune_2 {
    b2@moan e'4. g'8 |
    e'4. d'8 c'4 b4 |
    a4. f#8 d4 f#4 |
}

channel 0 horn octave 4 {
    // 1-2 Intro: the lead waits.
    r1 | r1 |

    // 3-10 A: the tune, in the plain horn. Its last E is held, and the drum rolls into B.
    tune_1
    tune_2
    e1@moan |

    // 11-18 B: the glimmer over C G | Am Em | C G | B B.
    use flow
    e'8 d'8 c'8 d'8 e'4 g'4 |
    g'4. a'8 b'2@glint |
    a'2@glint e'2@glint |
    g'4 f#'4 e'2@glint |
    e'8 d'8 c'8 d'8 e'4 g'4 |
    g'4. a'8 b'2@glint |
    a'2@glint f#'2@glint |
    d#'2.@glint b4 |

    // 19-26: the tune again in the brighter horn, ending on a long fading E.
    use horn2
    b2@moan2 e'4. d'8 |
    c'4. b8 g2@moan2 |
    a4. c'8 e'2@moan2 |
    f#'2.@moan2 d#'4 |
    b2@moan2 e'4. g'8 |
    e'4. d'8 c'4 b4 |
    a4. f#8 d4 f#4 |
    e1@last |
}

// --- Channel 1: bell, chords, drip ---------------------------------------------------------

// One chord a bar, as a quiet arpeggio. The roots are written in octave 3.
channel 1 toll octave 3 {
    // 1-2 Intro: the bell tolls E and B, a fifth apart, then again more softly.
    e'2 b2 |
    e'2@toll2 b2@toll2 |

    // 3-10 A: Em C | Am B | Em C | D Em.
    use pad_m e1 |
    use pad_M c1 |
    use pad_m a1 |
    use pad_M b1 |
    use pad_m e1 |
    use pad_M c1 |
    use pad_M d1 |
    use pad_m e1 |

    // 11-18 B: a descending arpeggio drips over C G | Am Em | C G | B, then a swelling B chord.
    use drip
    g'8 e'8 c'8 e'8 g'8 e'8 c'8 e'8 |
    d'8 b8 g8 b8 d'8 b8 g8 b8 |
    e'8 c'8 a8 c'8 e'8 c'8 a8 c'8 |
    e'8 b8 g8 b8 e'8 b8 g8 b8 |
    g'8 e'8 c'8 e'8 g'8 e'8 c'8 e'8 |
    d'8 b8 g8 b8 d'8 b8 g8 b8 |
    f#'8 d#'8 b8 d#'8 f#'8 d#'8 b8 d#'8 |
    use pad_M b1 |

    // 19-26 A': Em C | Am B | Em C | D, and a last Em that fades.
    use pad_m e1 |
    use pad_M c1 |
    use pad_m a1 |
    use pad_M b1 |
    use pad_m e1 |
    use pad_M c1 |
    use pad_M d1 |
    use pad_end e1 |
}

// --- Channel 2: drone and march -----------------------------------------------------------

channel 2 drone octave 2 {
    // 1-2 Intro: one long swelling E.
    e1 ~ e1 |

    // 3-10 A: roots and fifths, tolled once each half bar; a held E to close.
    use bass
    e2 b2 | c'2 g2 | a2 e'2 | b2 f#'2 |
    e2 b2 | c'2 g2 | d'2 a2 |
    use drone
    e1 |

    // 11-18 B: the same slow roots, then a pounding B, and a quicker B as the roll grows.
    use bass
    c'2 g2 | g2 d'2 | a2 e'2 | e2 b2 |
    c'2 g2 | g2 d'2 |
    use march
    b4 b4 b4 b4 |
    b8 b8 b8 b8 b8 b8 b8 b8 |

    // 19-26 A': a march of roots and fifths in quarter notes; the last E rejoins the drone.
    e4 b4 e4 b4 |
    c'4 g4 c'4 g4 |
    a4 e'4 a4 e'4 |
    b4 f#'4 b4 f#'4 |
    e4 b4 e4 b4 |
    c'4 g4 c'4 g4 |
    d'4 a4 d'4 a4 |
    use drone
    e1 |
}

// --- Channel 3: drums ------------------------------------------------------------------

channel 3 octave 4 {
    // 1-2 Intro: one soft drum, then two, then a short roll into the tune.
    c4@thud r2. |
    c4@thud r4 c4@thud c4@fill |

    // 3-10 A: a deep drum on beat one, a softer on beat three; a tap leads into the B chord.
    c4@boom r4 c4@thud r4 |
    c4@boom r4 c4@thud r4 |
    c4@boom r4 c4@thud r4 |
    c4@boom r4 c4@thud c4@tap |
    c4@boom r4 c4@thud r4 |
    c4@boom r4 c4@thud r4 |
    c4@boom r4 c4@thud r4 |
    c4@boom r2 c4@fill |

    // 11-18 B: a march with a tap on the even beats; the last bars pound and roll.
    repeat 6 { c4@boom c4@tap c4@thud c4@tap | }
    c4@boom c4@thud c4@boom c4@thud |
    c1@roll |

    // 19-26 A': the same march with eighth-note taps, then one last drum.
    repeat 6 { c4@boom c8@tap c8@tap c4@thud c8@tap c8@tap | }
    c4@boom c4@tap c4@thud c4@tap |
    c4@boom r2. |
}
