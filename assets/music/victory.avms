title "Victory"
description "Victory Loop by Ted Kerr (2017); trumpeting pulses, arpeggios and rapid bass"
tempo 180
meter 4/4
automation 16ms

// ------------------- Instrument palette -------------------

envelope fanfare { points 0ms:100%, 72ms:90%, 148ms:64%, 270ms:42% release 55ms:0% curve step }
envelope bell { points 0ms:100%, 110ms:76%, 220ms:48% release 50ms:0% curve step }
envelope percussion { points 0ms:100%, 32ms:65%, 90ms:22%, 145ms:0% curve step }
instrument victory_lead { wave pulse duty 25% volume 15 envelope fanfare gate 93% }
instrument victory_bell { wave pulse duty 50% volume 12 envelope bell gate 88% }
instrument victory_harmony { wave pulse duty 25% volume 10 envelope fanfare gate 90% }
instrument victory_bass { wave triangle volume 11 gate 90% }
instrument victory_kick { wave noise volume 9 envelope percussion gate 75% }
instrument victory_hat { wave noise volume 4 envelope percussion gate 60% }
instrument victory_snare { wave noise volume 7 envelope percussion gate 80% }


// ------------------- Reusable four-bar patterns -------------------
// Pattern 00, 4 attacks
phrase melody_00 {
    octave 3
    use victory_lead
    e1 |
    f1 |
    g1 |
    f1 |
}
// Pattern 01, 23 attacks
phrase melody_01 {
    octave 3
    use victory_lead
    a#,16 c16 c4. a#,16 c16 c4. |
    e8 f8 g8 a#2*5/4 |
    c'8 a#8 g8 g16 a#16 g8 f8 e8 d8 |
    a#,8 c8 c8 a#,2*5/4 |
}
// Pattern 02, 15 attacks
phrase melody_02 {
    octave 3
    use victory_bell
    d4. a#,4. c'4 |
    a#4 d2. |
    d16 d#16 d16 d#16 d2. |
    a#,16 c16 a#,16 c16 a#,2. |
}
// Pattern 03, 13 attacks
phrase melody_03 {
    octave 4
    use victory_bell
    c,4. d,4. a#,,4 |
    g#,,16 a#,,2*7/8 c16 a#,2*7/8 |
    d#8. f8. d#8 d4 c4 |
    d1 |
}
// Pattern 00, 4 attacks
phrase harmony_00 {
    octave 3
    use victory_harmony
    c1 |
    c1 |
    c1 |
    c1 |
}
// Pattern 01, 23 attacks
phrase harmony_01 {
    octave 3
    use victory_harmony
    a#,16 c16 c4. a#,16 c16 c4. |
    e8 f8 g8 a#2*5/4 |
    c'8 a#8 g8 g16 a#16 g8 f8 e8 d8 |
    a#,8 c8 c8 a#,2*5/4 |
}
// Pattern 02, 15 attacks
phrase harmony_02 {
    octave 3
    use victory_bell
    f4. g4. g#4 |
    f4 f2. |
    f16 g16 f16 g16 f2. |
    d16 d#16 d16 d#16 d2. |
}
// Pattern 03, 12 attacks
phrase harmony_03 {
    octave 4
    use victory_bell
    d#,4. f,4. d4 |
    c16 d2*7/8 d#16 d2*7/8 |
    g8. d8. g8 f2 |
    a#,1 |
}
// Pattern 04, 64 attacks
phrase harmony_04 {
    octave 2
    use victory_bell
    repeat 4 { c'16 g16 e16 g16 } |
    repeat 4 { c'16 g16 f16 g16 } |
    repeat 4 { c'16 g16 e16 g16 } |
    repeat 4 { a#16 g16 f16 g16 } |
}
// Pattern 00, 36 attacks
phrase bass_00 {
    octave 3
    use victory_bass
    c8. c16 c'8 a#8 g8 c8 c8 a#,16 g,16 |
    c8. c16 c'8 a#8 g8 c8 c8 a#,16 g,16 |
    c8. c16 c'8 a#8 g8 c8 c8 a#,16 g,16 |
    c8. c16 c'8 a#8 g8 c8 c8 a#,16 g,16 |
}
// Pattern 01, 36 attacks
phrase bass_01 {
    octave 2
    use victory_bass
    a#8. a#16 a#'8 g#'8 f'8 a#8 a#8 g#16 f16 |
    a#8. a#16 a#'8 g#'8 f'8 a#8 a#8 g#16 f16 |
    a#8. a#16 a#'8 g#'8 f'8 a#8 a#8 g#16 f16 |
    a#8. a#16 a#'8 g#'8 f'8 a#8 a#8 g#16 f16 |
}
// Pattern 00, 48 attacks
phrase drums_00 {
    octave 2
    use victory_hat
    repeat 2 { f,8@victory_kick f16 f16 a#,8@victory_kick f16 f16 } |
    repeat 2 { f,8@victory_kick f16 f16 a#,8@victory_kick f16 f16 } |
    repeat 2 { f,8@victory_kick f16 f16 a#,8@victory_kick f16 f16 } |
    repeat 2 { f,8@victory_kick f16 f16 a#,8@victory_kick f16 f16 } |
}

// ------------------- Pattern order / four output channels -------------------
channel 0 victory_lead octave 3 {
    melody_00 melody_00 melody_01 melody_01 melody_02
    melody_03 melody_00 melody_00 melody_02 melody_03
}
channel 1 victory_harmony octave 3 {
    harmony_00 harmony_00 harmony_01 harmony_01 harmony_02
    harmony_03 harmony_04 harmony_04 harmony_02 harmony_03
}
channel 2 victory_bass octave 3 {
    repeat 4 { bass_00 } bass_01 bass_01 bass_00 bass_00
    bass_01 bass_01
}
channel 3 victory_kick octave 3 {
    repeat 10 { drums_00 }
}
