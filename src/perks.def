// Class, rank, identifier, effect magnitude, required range (0 for any), name, description.
// Keep each track's entries consecutive and in ascending rank order.
MOVEMENT_PERK(MOVEMENT_STEP, 1, HOLD_TOGETHER, 1, 0, "Hold Together",
              "While beside a living ally, take 1 less direct damage per hit, down to 1.")
MOVEMENT_PERK(MOVEMENT_STEP, 2, FOOTWORK, 0, 0, "Footwork",
              "A Step that deals engagement damage costs 0 HP.")
MOVEMENT_PERK(MOVEMENT_STEP, 3, SHIELD_WALL, 1, 0, "Shield Wall",
            "Beside a living ally, reduce direct damage by 2 total, down to 1.")
MOVEMENT_PERK(MOVEMENT_STEP, 4, SHIELD_REBOUND, 0, 0, "Shield Rebound",
              "Beside a living ally, reflect half of a direct hit, rounded down. Shield Wall reduces your share.")
MOVEMENT_PERK(MOVEMENT_LEAP, 1, LANDING_STRIKE, 1, 0, "Landing Strike",
              "Landing next to exactly one enemy deals 1 extra engagement damage to it.")
MOVEMENT_PERK(MOVEMENT_LEAP, 2, WIDE_LANDING, 1, 0, "Wide Landing",
              "Landing next to exactly two enemies deals 1 extra engagement damage to each.")
MOVEMENT_PERK(MOVEMENT_LEAP, 3, SKYFALL, 1, 0, "Skyfall",
            "Deal 1 extra engagement damage to every enemy beside the landing.")
MOVEMENT_PERK(MOVEMENT_LEAP, 4, SKYHOOK, 0, 0, "Skyhook",
              "Land beside exactly one enemy. If it survives engagement, pull it onto your takeoff cell.")
MOVEMENT_PERK(MOVEMENT_CHARGE, 1, SPEARHEAD, 1, 0, "Spearhead",
              "Deal 1 extra engagement damage to the enemy directly ahead of the landing.")
MOVEMENT_PERK(MOVEMENT_CHARGE, 2, MOMENTUM, 1, 2, "Momentum",
              "A two-cell move deals 1 extra engagement damage to each adjacent enemy.")
MOVEMENT_PERK(MOVEMENT_CHARGE, 3, OVERRUN, 1, 0, "Overrun",
            "After engagement, push the surviving enemy directly ahead one open cell farther.")
MOVEMENT_PERK(MOVEMENT_CHARGE, 4, TRAMPLE, 0, 2, "Trample",
              "Charge through an enemy to an open landing two cells away. The crossed enemy also takes Spearhead damage.")
MOVEMENT_PERK(MOVEMENT_VAULT, 1, VAULT_STRIKE, 1, 0, "Vault Strike",
              "Deal 1 extra engagement damage to the enemy you Vault over.")
MOVEMENT_PERK(MOVEMENT_VAULT, 2, VAULT_FORCE, 1, 0, "Vault Force",
              "Every Vault landing deals 1 extra engagement damage to each adjacent enemy.")
MOVEMENT_PERK(MOVEMENT_VAULT, 3, SHOCK_LANDING, 1, 0, "Shock Landing",
            "Deal 1 engagement damage to enemies diagonally beside the landing.")
MOVEMENT_PERK(MOVEMENT_VAULT, 4, HIGH_VAULT, 0, 3, "High Vault",
              "If the usual landing is blocked, Vault one cell farther if open. Deal Vault Strike damage to each enemy crossed.")
MOVEMENT_PERK(MOVEMENT_GLIDE, 1, CUTBACK, 1, 1, "Cutback",
              "A one-cell Glide deals 1 extra engagement damage if exactly one enemy is beside the landing.")
MOVEMENT_PERK(MOVEMENT_GLIDE, 2, SLIPSTREAM, 1, 2, "Slipstream",
              "A two-cell diagonal move deals 1 extra engagement damage to each adjacent enemy.")
MOVEMENT_PERK(MOVEMENT_GLIDE, 3, PASSING_CUT, 1, 0, "Passing Cut",
            "Deal 1 damage to enemies beside takeoff or midpoint. Each enemy is hit once. Landing damage wins.")
MOVEMENT_PERK(MOVEMENT_GLIDE, 4, DIAMOND_WAKE, 0, 2, "Diamond Wake",
              "A two-cell Glide deals full engagement beside and diagonally beside takeoff or midpoint. Each enemy is hit once.")
ATTACK_PERK(ATTACK_STRIKE, 1, KEEN_EDGE, 1, 0, "Keen Edge",
            "Normal and special attacks deal 1 extra damage against enemies at full HP.")
ATTACK_PERK(ATTACK_STRIKE, 2, SWORD_MASTERY, 1, 0, "Sword Mastery",
            "Normal and special Strike attacks deal 1 extra damage.")
ATTACK_PERK(ATTACK_STRIKE, 3, DUELIST, 2, 0, "Duelist",
            "Deal 2 extra direct damage if the target has no living ally beside it.")
ATTACK_PERK(ATTACK_STRIKE, 4, BLADE_LOCK, 0, 0, "Blade Lock",
            "An isolated enemy beside a rank 4 Strike fighter cannot move voluntarily.")
ATTACK_PERK(ATTACK_SHOOT, 1, LONGSHOT, 1, 4, "Longshot",
            "Normal and special attacks deal 1 extra damage at range 4.")
ATTACK_PERK(ATTACK_SHOOT, 2, SHARPSHOOTER, 1, 0, "Sharpshooter",
            "Normal and special Shoot attacks deal 1 extra damage at every legal range.")
ATTACK_PERK(ATTACK_SHOOT, 3, PIERCING_SHOT, 2, 0, "Piercing Shot",
            "Deal 2 damage to an enemy in the cell directly behind the target.")
ATTACK_PERK(ATTACK_SHOOT, 4, THROUGHSHOT, 0, 0, "Throughshot",
            "Shoot the first enemy at least two cells away. Hit all enemies behind it at full damage until a wall, ally, or board edge.")
ATTACK_PERK(ATTACK_REACH, 1, LUNGE, 1, 2, "Lunge",
            "Normal and special attacks deal 1 extra damage at range 2.")
ATTACK_PERK(ATTACK_REACH, 2, SHORT_GRIP, 2, 1, "Short Grip",
            "Normal and special Reach attacks deal 2 extra damage at range 1.")
ATTACK_PERK(ATTACK_REACH, 3, THROUGH_THE_RANKS, 0, 2, "Through the Ranks",
            "At range 2, Reach can attack through a living ally in the middle cell.")
ATTACK_PERK(ATTACK_REACH, 4, PIKE_FENCE, 0, 0, "Pike Fence",
            "An enemy outside your Reach cannot move to a cell you could hit after it lands.")
ATTACK_PERK(ATTACK_IMPACT, 1, BODY_CHECK, 1, 0, "Body Check",
            "Impact and Crushing Bash deal 1 extra damage if a living unit occupies the push cell.")
ATTACK_PERK(ATTACK_IMPACT, 2, HEAVY_BLOW, 1, 0, "Heavy Blow",
            "Normal and special attacks deal 1 extra damage.")
ATTACK_PERK(ATTACK_IMPACT, 3, COLLISION, 3, 0, "Collision",
            "Deal 3 damage to an enemy occupying the push cell, even if the main hit kills.")
ATTACK_PERK(ATTACK_IMPACT, 4, WRECKING_LINE, 0, 0, "Wrecking Line",
            "Deal Collision damage to the line of enemies behind the target. Push all survivors into the open space beyond.")
ATTACK_PERK(ATTACK_REND, 1, BLOODLETTING, 0, 0, "Bloodletting",
            "Rend deals 4 base damage against targets below three quarters of maximum HP.")
ATTACK_PERK(ATTACK_REND, 2, BLOOD_SENSE, 1, 0, "Blood Sense",
            "Normal and special attacks deal 1 extra damage against enemies below full HP.")
ATTACK_PERK(ATTACK_REND, 3, BLOOD_RUSH, 2, 0, "Blood Rush",
            "Deal 2 extra direct damage at half of your own maximum HP or below.")
ATTACK_PERK(ATTACK_REND, 4, BLOOD_HUNT, 0, 2, "Blood Hunt",
            "Rend and Wound Hunter can hit from two cells away along a clear line if the target is below half HP.")
ATTACK_PERK(ATTACK_ARC, 1, OPEN_ANGLE, 1, 0, "Open Angle",
            "Arc and Crescent Cut deal 1 extra damage when both orthogonal corner cells are open.")
ATTACK_PERK(ATTACK_ARC, 2, CROSSCUT, 1, 0, "Crosscut",
            "Normal and special Arc attacks deal 1 extra damage.")
ATTACK_PERK(ATTACK_ARC, 3, INSIDE_ANGLE, 2, 0, "Inside Angle",
            "Deal 2 extra direct damage when an enemy occupies either orthogonal corner cell.")
ATTACK_PERK(ATTACK_ARC, 4, CORNER_SWEEP, 0, 0, "Corner Sweep",
            "Also hit enemies in both orthogonal corner cells for the primary hit's damage before defense.")
ATTACK_PERK(ATTACK_DRAIN, 1, LIFE_TAP, 1, 0, "Life Tap",
            "Drain can heal 2 HP. On a surviving target, healing is capped at 1 less than HP lost.")
ATTACK_PERK(ATTACK_DRAIN, 2, DEEP_CUT, 1, 0, "Deep Cut",
            "Drain and Siphon deal 1 extra direct damage.")
ATTACK_PERK(ATTACK_DRAIN, 3, DEEP_SIPHON, 1, 0, "Deep Siphon",
            "Drain can heal 3 HP. A surviving target caps healing at 1 less than HP lost.")
ATTACK_PERK(ATTACK_DRAIN, 4, SOUL_DIVIDEND, 5, 0, "Soul Dividend",
            "A finishing blow heals you and every living ally for up to 5 HP each.")
ATTACK_PERK(ATTACK_RECOIL, 1, PARTING_BLOW, 1, 0, "Parting Blow",
            "Recoil and Spring Blow deal 1 extra damage when the retreat succeeds.")
ATTACK_PERK(ATTACK_RECOIL, 2, COUNTERFORCE, 1, 0, "Counterforce",
            "Normal and special Recoil attacks deal 1 extra damage.")
ATTACK_PERK(ATTACK_RECOIL, 3, SPRINGBACK, 1, 0, "Springback",
            "Recoil retreats up to two open cells, stopping at the first obstruction.")
ATTACK_PERK(ATTACK_RECOIL, 4, DRAGBACK, 0, 0, "Dragback",
            "When you retreat, pull the surviving target into the cell you vacated.")
ATTACK_PERK(ATTACK_FLANK, 1, ENCIRCLE, 1, 0, "Encircle",
            "Flank deals 1 extra damage when another ally is orthogonally adjacent to the target.")
ATTACK_PERK(ATTACK_FLANK, 2, TACTICAL_EDGE, 1, 0, "Tactical Edge",
            "Flank and Pincer Strike deal 1 extra damage on every hit.")
ATTACK_PERK(ATTACK_FLANK, 3, CONVERGING_BLADES, 1, 0, "Converging Blades",
            "Deal 1 extra direct damage per ally supporting the flank.")
ATTACK_PERK(ATTACK_FLANK, 4, BLIND_SIDE, 0, 0, "Blind Side",
            "Hit from two cells straight or one diagonally if a living ally shares an edge with both you and your target.")
ATTACK_PERK(ATTACK_BLAST, 1, CLUSTER_BURST, 1, 0, "Cluster Burst",
            "Blast and Detonation deal 1 extra primary damage if at least two enemies take splash damage.")
ATTACK_PERK(ATTACK_BLAST, 2, SHRAPNEL, 1, 0, "Shrapnel",
            "Normal and special Blast attacks deal 2 damage to each secondary enemy.")
ATTACK_PERK(ATTACK_BLAST, 3, SHOCKWAVE, 1, 0, "Shockwave",
            "Deal 1 splash damage to enemies diagonally beside the target.")
ATTACK_PERK(ATTACK_BLAST, 4, CONCUSSION, 0, 0, "Concussion",
            "Push surviving splash targets one cell away from the blast center if their destinations were open before the hit.")
